@inject AppText T

<div class="brand-block">
    <NavLink class="brand-mark" href="" Match="NavLinkMatch.All">
        <span class="brand-code">&lt;/&gt;</span>
        <strong>TrueCompare</strong>
        <small>@T["Nav.Tagline"]</small>
    </NavLink>
</div>

<input type="checkbox" title='@T["Nav.Open"]' class="navbar-toggler" />

<div class="nav-scrollable">
    <nav class="nav-list">
        <NavLink class="nav-link primary-nav" href="" Match="NavLinkMatch.All">
            <span>@T["Nav.NewChat"]</span>
            <span>+</span>
        </NavLink>

        <a class="nav-link" href="/#categories">
            <span>@T["Nav.Categories"]</span>
        </a>

        <NavLink class="nav-link" href="results">
            <span>@T["Nav.History"]</span>
        </NavLink>
    </nav>

    <nav class="nav-footer" aria-label="Secondary">
        <NavLink class="nav-footer-link" href="features">
            <span aria-hidden="true">▷</span>
            <span>@T["Nav.Activity"]</span>
        </NavLink>
        <NavLink class="nav-footer-link" href="credits">
            <span aria-hidden="true">⚙</span>
            <span>@T["Nav.Settings"]</span>
        </NavLink>
    </nav>
</div>
