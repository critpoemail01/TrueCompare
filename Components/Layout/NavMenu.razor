@inject AppText T
@inject NavigationManager Navigation

<div class="brand-block">
    <NavLink class="brand-mark" href="" Match="NavLinkMatch.All">
        <span class="brand-code">&lt;/&gt;</span>
        <strong>TrueCompare</strong>
        <small>@T["Nav.Tagline"]</small>
    </NavLink>
</div>

<input type="checkbox" title='@T["Nav.Open"]' class="navbar-toggler" />

<div class="nav-scrollable">
    <nav class="nav-list">
        <button type="button" class="nav-link primary-nav" @onclick="StartNewChat" aria-label='@T["Nav.NewChat"]'>
            <span>@T["Nav.NewChat"]</span>
            <span>+</span>
        </button>

        <NavLink class="nav-link" href="alerts">
            <span>@T["Nav.ActiveAlerts"]</span>
        </NavLink>

        <NavLink class="nav-link" href="history">
            <span>@T["Nav.ProductHistory"]</span>
        </NavLink>
    </nav>

    <AuthorizeView>
        <Authorized>
            <nav class="nav-list nav-footer" aria-label='@T["Nav.UserMenu"]'>
                <NavLink class="nav-link settings-nav" href="settings">
                    <span class="settings-nav-icon" aria-hidden="true">&#9881;</span>
                    <span>@T["Nav.Settings"]</span>
                </NavLink>
            </nav>
        </Authorized>
    </AuthorizeView>
</div>

@code {
    private void StartNewChat()
    {
        Navigation.NavigateTo($"/?newChat={Guid.NewGuid():N}");
    }
}
