@page "/settings"
@attribute [Authorize]
@using Microsoft.AspNetCore.Identity
@inject AuthenticationStateProvider AuthenticationStateProvider
@inject UserManager<ApplicationUser> UserManager
@inject AppText T

<PageTitle>@T["Settings.PageTitle"]</PageTitle>

<section class="page-header compact-header">
    <div>
        <p class="eyebrow">@T["Settings.Eyebrow"]</p>
        <h1>@T["Settings.Title"]</h1>
        <p>@T["Settings.Lead"]</p>
    </div>
</section>

@if (!string.IsNullOrWhiteSpace(Message))
{
    <div class="form-message" role="status">@Message</div>
}

@if (IsLoading)
{
    <div class="form-message" role="status">@T["Settings.Loading"]</div>
}
else if (CurrentUser is not null)
{
    <section class="settings-grid">
        <article class="settings-panel">
            <div class="settings-panel-copy">
                <h2>@T["Settings.ProfileTitle"]</h2>
                <p>@T["Settings.ProfileLead"]</p>
            </div>

            <form method="post" action="/auth/settings/profile" class="auth-form settings-form">
                <AntiforgeryToken />

                <label>
                    @T["Settings.DisplayName"]
                    <input name="DisplayName" value="@CurrentUser.DisplayName" autocomplete="name" maxlength="120" />
                </label>

                <label>
                    @T["Settings.Email"]
                    <input name="Email" type="email" value="@CurrentUser.Email" autocomplete="email" maxlength="256" required />
                </label>

                <button class="primary-button wide" type="submit">@T["Settings.SaveProfile"]</button>
            </form>
        </article>

        <article class="settings-panel">
            <div class="settings-panel-copy">
                <h2>@T["Settings.PasswordTitle"]</h2>
                <p>@(HasPassword ? T["Settings.PasswordLead"] : T["Settings.NoPasswordLead"])</p>
            </div>

            <form method="post" action="/auth/settings/password" class="auth-form settings-form">
                <AntiforgeryToken />

                @if (HasPassword)
                {
                    <label>
                        @T["Settings.CurrentPassword"]
                        <input name="CurrentPassword" type="password" autocomplete="current-password" required />
                    </label>
                }

                <label>
                    @T["Settings.NewPassword"]
                    <input name="NewPassword" type="password" autocomplete="new-password" minlength="10" required />
                </label>

                <label>
                    @T["Settings.ConfirmNewPassword"]
                    <input name="ConfirmNewPassword" type="password" autocomplete="new-password" minlength="10" required />
                </label>

                <button class="primary-button wide" type="submit">@T["Settings.ChangePassword"]</button>
            </form>
        </article>
    </section>
}

@code {
    private ApplicationUser? CurrentUser { get; set; }

    private bool HasPassword { get; set; }

    private bool IsLoading { get; set; } = true;

    [SupplyParameterFromQuery]
    public string? Message { get; set; }

    protected override async Task OnInitializedAsync()
    {
        var authState = await AuthenticationStateProvider.GetAuthenticationStateAsync();
        CurrentUser = await UserManager.GetUserAsync(authState.User);
        if (CurrentUser is not null)
        {
            HasPassword = await UserManager.HasPasswordAsync(CurrentUser);
        }

        IsLoading = false;
    }
}
