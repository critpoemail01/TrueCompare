@page "/credits"
@attribute [Authorize]
@inject AuthenticationStateProvider AuthenticationStateProvider
@inject SearchQuotaService QuotaService
@inject Microsoft.Extensions.Options.IOptions<StripeOptions> StripeOptionsAccessor
@inject AppText T

<PageTitle>@T["Credits.PageTitle"]</PageTitle>

<section class="page-header compact-header">
    <div>
        <p class="eyebrow">@T["Credits.Eyebrow"]</p>
        <h1>@T["Credits.Title"]</h1>
    </div>
    <a class="secondary-button" href="/">@T["Credits.NewSearch"]</a>
</section>

@if (!string.IsNullOrWhiteSpace(Message))
{
    <div class="form-message">@Message</div>
}

@if (Status is null)
{
    <p class="muted-label">@T["Credits.Loading"]</p>
}
else
{
    <section class="credit-status-grid">
        <article>
            <span>@T["Credits.FreeUsed"]</span>
            <strong>@Status.FreeSearchesUsed / @Status.FreeSearchLimit</strong>
        </article>
        <article>
            <span>@T["Credits.FreeRemaining"]</span>
            <strong>@Status.FreeSearchesRemaining</strong>
        </article>
        <article>
            <span>@T["Credits.Available"]</span>
            <strong>@Status.Credits</strong>
        </article>
    </section>
}

<section class="credit-packages">
    @foreach (var package in Packages)
    {
        <article class="credit-package">
            <span>@T.Format("Credits.PackageCredits", package.Credits)</span>
            <h2>@package.Name</h2>
            <strong>@FormatPrice(package)</strong>
            <form method="post" action="/billing/create-checkout-session">
                <AntiforgeryToken />
                <input type="hidden" name="packageId" value="@package.Id" />
                <button class="primary-button wide" type="submit">@T["Credits.PayByCard"]</button>
            </form>
        </article>
    }
</section>


@code {
    [SupplyParameterFromQuery]
    public string? Message { get; set; }

    private SearchQuotaStatus? Status { get; set; }

    private IReadOnlyList<CreditPackage> Packages => StripeOptionsAccessor.Value.CreditPackages;

    protected override async Task OnInitializedAsync()
    {
        var authState = await AuthenticationStateProvider.GetAuthenticationStateAsync();
        var userId = authState.User.FindFirst(System.Security.Claims.ClaimTypes.NameIdentifier)?.Value;
        if (!string.IsNullOrWhiteSpace(userId))
        {
            Status = await QuotaService.GetStatusAsync(userId);
        }
    }

    private static string FormatPrice(CreditPackage package)
    {
        return (package.AmountCents / 100m).ToString("C", System.Globalization.CultureInfo.GetCultureInfo("pt-PT"));
    }
}
