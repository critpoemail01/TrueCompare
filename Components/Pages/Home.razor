@page "/"
@implements IAsyncDisposable
@using Microsoft.AspNetCore.Components.Forms
@using Microsoft.AspNetCore.Components.Web
@inject ComparisonDataService Data
@inject NavigationManager Navigation
@inject AuthenticationStateProvider AuthenticationStateProvider
@inject SearchQuotaService QuotaService
@inject IProductImageSuggestionService ImageSuggestionService
@inject IJSRuntime JS
@inject AppText T

<PageTitle>TrueCompare</PageTitle>

<section class="home-screen">
    <div class="hero-copy">
        <h1>@T["Home.Title"]</h1>
        <p class="lead">@T["Home.Lead"]</p>

        <div id="@PromptPanelId" class="prompt-panel mock-prompt">
            <div class="image-upload-cell @(IsAnalyzingImage ? "is-busy" : null)" title='@T["Home.ImageUploadAria"]'>
                <span class="prompt-plus" aria-hidden="true">+</span>
                <InputFile id="product-image" class="image-file-input" accept="image/*" OnChange="HandleImageSelected" aria-label='@T["Home.ImageUploadAria"]' disabled="@IsAnalyzingImage" />
            </div>
            <input id="prompt" aria-label='@T["Home.ProductAria"]' placeholder="@PromptPlaceholder" @bind="Prompt" @bind:event="oninput" @onclick="HidePromptPlaceholder" @onfocusin="HidePromptPlaceholder" @onfocusout="ShowPromptPlaceholder" @onkeydown="HandlePromptKeyDown" />
            <button class="search-send" type="button" @onclick="StartComparison" disabled="@IsSubmitting" aria-label='@T["Home.CompareAria"]'>
                @if (IsSubmitting)
                {
                    <span class="search-send-loader" aria-hidden="true"></span>
                }
                else
                {
                    <span class="search-send-icon" aria-hidden="true">&#8594;</span>
                }
            </button>
        </div>

        @if (IsAnalyzingImage || ImageSuggestion is not null || !string.IsNullOrWhiteSpace(SelectedImagePreviewDataUrl))
        {
            <section class="image-suggestion-card" aria-live="polite">
                @if (!string.IsNullOrWhiteSpace(SelectedImagePreviewDataUrl))
                {
                    <img src="@SelectedImagePreviewDataUrl" alt="" />
                }
                <div>
                    <span>@(IsAnalyzingImage ? T["Home.ImageAnalyzing"] : ImageSuggestion?.SourceLabel)</span>
                    <strong>@(ImageSuggestion?.DetectedProductType ?? SelectedImageName ?? T["Home.ImageSuggestion"])</strong>
                    @if (ImageSuggestion is not null)
                    {
                        <p>@ImageSuggestion.Summary</p>
                    }
                </div>
            </section>
        }

        @if (!string.IsNullOrWhiteSpace(QuotaMessage))
        {
            <p class="quota-message">@QuotaMessage</p>
        }

        <div class="category-menu" id="categories">
            @foreach (var category in Data.Categories)
            {
                <button type="button" class="@(category == ActiveCategory ? "active" : null)" @onclick="() => UseCategory(category)">
                    @category
                </button>
            }
        </div>
    </div>
</section>

<section class="capability-strip" aria-label='@T["Home.Capabilities"]'>
    <a href="results" style="--accent:#7BE8E0">
        <strong>@T["Home.Compare"]</strong>
        <span>@T["Home.Products"]</span>
    </a>
    <a href="product/macbook-air-m3" style="--accent:#5EE9A8">
        <strong>@T["Home.Verify"]</strong>
        <span>@T["Home.Authenticity"]</span>
    </a>
    <a href="criteria" style="--accent:#B49CFF">
        <strong>@T["Home.Weigh"]</strong>
        <span>@T["Home.Criteria"]</span>
    </a>
    <a href="checkout" style="--accent:#E97B7B">
        <strong>@T["Home.Choose"]</strong>
        <span>@T["Home.Seller"]</span>
    </a>
    <a href="checkout" style="--accent:#E9D67B">
        <strong>@T["Home.Buy"]</strong>
        <span>@T["Home.Now"]</span>
    </a>
    <a href="tutorials" style="--accent:#F0A36A">
        <strong>@T["Home.Master"]</strong>
        <span>@T["Home.Flows"]</span>
    </a>
</section>

@code {
    private const long MaxImageBytes = 5 * 1024 * 1024;
    private const string PromptPanelId = "home-prompt-panel";

    private string Prompt { get; set; } = string.Empty;
    private string ActiveCategory { get; set; } = string.Empty;
    private bool IsSubmitting { get; set; }
    private bool IsAnalyzingImage { get; set; }
    private bool IsPromptFocused { get; set; }
    private string? QuotaMessage { get; set; }
    private string? SelectedImageName { get; set; }
    private string? SelectedImagePreviewDataUrl { get; set; }
    private ImageProductSuggestionResult? ImageSuggestion { get; set; }
    private IJSObjectReference? pasteImagesModule;
    private DotNetObjectReference<Home>? dotNetReference;
    private string PromptPlaceholder => IsPromptFocused ? string.Empty : T["Home.DefaultPrompt"];

    private void HidePromptPlaceholder()
    {
        IsPromptFocused = true;
    }

    private void ShowPromptPlaceholder()
    {
        IsPromptFocused = false;
    }

    private void UseCategory(string category)
    {
        ActiveCategory = category;
        Prompt = T.Format("Home.CategoryPrompt", category);
    }

    private async Task HandlePromptKeyDown(KeyboardEventArgs args)
    {
        if (args.Key.Equals("Enter", StringComparison.OrdinalIgnoreCase))
        {
            await StartComparison();
        }
    }

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (!firstRender)
        {
            return;
        }

        dotNetReference = DotNetObjectReference.Create(this);
        pasteImagesModule = await JS.InvokeAsync<IJSObjectReference>("import", "./truecompare-paste-images.js?v=1");
        await pasteImagesModule.InvokeVoidAsync("connect", PromptPanelId, dotNetReference, MaxImageBytes);
    }

    private async Task HandleImageSelected(InputFileChangeEventArgs args)
    {
        var file = args.File;
        if (file is null)
        {
            return;
        }

        if (file.Size > MaxImageBytes)
        {
            SelectedImagePreviewDataUrl = null;
            QuotaMessage = T["Home.ImageTooLarge"];
            return;
        }

        IsAnalyzingImage = true;
        try
        {
            await using var stream = file.OpenReadStream(MaxImageBytes);
            using var memoryStream = new MemoryStream();
            await stream.CopyToAsync(memoryStream);

            await AnalyzeImageBytesAsync(file.Name, file.ContentType, memoryStream.ToArray(), file.Size);
        }
        catch
        {
            QuotaMessage = T["Home.ImageAnalysisFailed"];
        }
        finally
        {
            IsAnalyzingImage = false;
        }
    }

    [JSInvokable]
    public async Task HandlePastedImageAsync(string fileName, string contentType, string base64Image, long size)
    {
        if (size > MaxImageBytes)
        {
            await HandlePastedImageRejectedAsync("too-large");
            return;
        }

        try
        {
            var imageBytes = Convert.FromBase64String(base64Image);
            await AnalyzeImageBytesAsync(fileName, contentType, imageBytes, size);
        }
        catch
        {
            QuotaMessage = T["Home.ImageAnalysisFailed"];
            await InvokeAsync(StateHasChanged);
        }
    }

    [JSInvokable]
    public Task HandlePastedImageRejectedAsync(string reason)
    {
        ImageSuggestion = null;
        SelectedImageName = null;
        SelectedImagePreviewDataUrl = null;
        QuotaMessage = reason.Equals("too-large", StringComparison.OrdinalIgnoreCase)
            ? T["Home.ImageTooLarge"]
            : T["Home.ImageInvalid"];

        return InvokeAsync(StateHasChanged);
    }

    private async Task AnalyzeImageBytesAsync(string fileName, string contentType, byte[] imageBytes, long size)
    {
        QuotaMessage = null;
        ImageSuggestion = null;
        SelectedImageName = string.IsNullOrWhiteSpace(fileName) ? T["Home.ImageSuggestion"] : fileName;

        if (!contentType.StartsWith("image/", StringComparison.OrdinalIgnoreCase) || imageBytes.Length == 0)
        {
            SelectedImagePreviewDataUrl = null;
            QuotaMessage = T["Home.ImageInvalid"];
            return;
        }

        if (size > MaxImageBytes || imageBytes.LongLength > MaxImageBytes)
        {
            SelectedImagePreviewDataUrl = null;
            QuotaMessage = T["Home.ImageTooLarge"];
            return;
        }

        IsAnalyzingImage = true;
        await InvokeAsync(StateHasChanged);

        try
        {
            SelectedImagePreviewDataUrl = $"data:{contentType};base64,{Convert.ToBase64String(imageBytes)}";
            ImageSuggestion = await ImageSuggestionService.AnalyzeImageAsync(SelectedImageName, contentType, imageBytes);
            if (!string.IsNullOrWhiteSpace(ImageSuggestion.SuggestedQuery))
            {
                Prompt = ImageSuggestion.SuggestedQuery;
            }
        }
        finally
        {
            IsAnalyzingImage = false;
        }
    }

    private async Task StartComparison()
    {
        if (IsSubmitting)
        {
            return;
        }

        if (IsAnalyzingImage)
        {
            QuotaMessage = T["Home.ImageAnalyzing"];
            return;
        }

        if (string.IsNullOrWhiteSpace(Prompt) && !string.IsNullOrWhiteSpace(ImageSuggestion?.SuggestedQuery))
        {
            Prompt = ImageSuggestion.SuggestedQuery;
        }

        if (string.IsNullOrWhiteSpace(Prompt))
        {
            QuotaMessage = T["Home.MissingProduct"];
            return;
        }

        IsSubmitting = true;
        QuotaMessage = null;

        var criteriaUrl = $"/criteria?query={Uri.EscapeDataString(Prompt)}";
        var authState = await AuthenticationStateProvider.GetAuthenticationStateAsync();
        var userId = authState.User.FindFirst(System.Security.Claims.ClaimTypes.NameIdentifier)?.Value;

        if (string.IsNullOrWhiteSpace(userId))
        {
            Navigation.NavigateTo($"/login?returnUrl={Uri.EscapeDataString(criteriaUrl)}", forceLoad: true);
            return;
        }

        var result = await QuotaService.TryConsumeAsync(userId, Prompt);
        if (!result.Allowed)
        {
            Navigation.NavigateTo($"/credits?returnUrl={Uri.EscapeDataString(criteriaUrl)}&message={Uri.EscapeDataString(T["Home.NoCredits"])}", forceLoad: true);
            return;
        }

        Navigation.NavigateTo(criteriaUrl);
    }

    public async ValueTask DisposeAsync()
    {
        if (pasteImagesModule is not null)
        {
            try
            {
                await pasteImagesModule.InvokeVoidAsync("disconnect", PromptPanelId);
                await pasteImagesModule.DisposeAsync();
            }
            catch (JSDisconnectedException)
            {
            }
        }

        dotNetReference?.Dispose();
    }
}
