@page "/"
@implements IAsyncDisposable
@using Microsoft.AspNetCore.Components.Forms
@using Microsoft.AspNetCore.Components.Web
@inject ComparisonDataService Data
@inject ProductConversationService Conversation
@inject NavigationManager Navigation
@inject AuthenticationStateProvider AuthenticationStateProvider
@inject SearchQuotaService QuotaService
@inject IProductImageSuggestionService ImageSuggestionService
@inject IJSRuntime JS
@inject AppText T

<PageTitle>TrueCompare</PageTitle>

<section class="home-screen @(ChatMessages.Count > 0 ? "has-chat" : null)">
    <div class="hero-copy">
        <h1>@T["Home.Title"]</h1>
        <p class="lead">@T["Home.Lead"]</p>

        <div id="@PromptPanelId" class="prompt-panel mock-prompt">
            <div class="image-upload-cell @(IsAnalyzingImage ? "is-busy" : null)" title='@T["Home.ImageUploadAria"]'>
                <span class="prompt-plus" aria-hidden="true">+</span>
                <InputFile id="product-image" class="image-file-input" accept="image/*" OnChange="HandleImageSelected" aria-label='@T["Home.ImageUploadAria"]' disabled="@IsAnalyzingImage" />
            </div>
            <input id="@PromptInputId" aria-label='@T["Home.ProductAria"]' placeholder="@PromptPlaceholder" @bind="Prompt" @bind:event="oninput" @onclick="HidePromptPlaceholder" @onfocusin="HidePromptPlaceholder" @onfocusout="ShowPromptPlaceholder" @onkeydown="HandlePromptKeyDown" />
            <button class="search-send" type="button" @onclick="StartComparison" disabled="@IsSubmitting" aria-label='@T["Home.CompareAria"]'>
                @if (IsSubmitting)
                {
                    <span class="search-send-loader" aria-hidden="true"></span>
                }
                else
                {
                    <span class="search-send-icon" aria-hidden="true">&#8594;</span>
                }
            </button>
        </div>

        @if (IsAnalyzingImage || ImageSuggestion is not null || !string.IsNullOrWhiteSpace(SelectedImagePreviewDataUrl))
        {
            <section class="image-suggestion-card" aria-live="polite">
                @if (!string.IsNullOrWhiteSpace(SelectedImagePreviewDataUrl))
                {
                    <img src="@SelectedImagePreviewDataUrl" alt="" />
                }
                <div>
                    <span>@(IsAnalyzingImage ? T["Home.ImageAnalyzing"] : ImageSuggestion?.SourceLabel)</span>
                    <strong>@(ImageSuggestion?.DetectedProductType ?? SelectedImageName ?? T["Home.ImageSuggestion"])</strong>
                    @if (ImageSuggestion is not null)
                    {
                        <p>@ImageSuggestion.Summary</p>
                    }
                </div>
                @if (!string.IsNullOrWhiteSpace(SelectedImagePreviewDataUrl))
                {
                    <button type="button" class="image-remove-button" @onclick="ClearImageSuggestion" aria-label='@T["Home.RemoveImage"]'>
                        @T["Home.RemoveImage"]
                    </button>
                }
            </section>
        }

        @if (!string.IsNullOrWhiteSpace(QuotaMessage))
        {
            <p class="quota-message">@QuotaMessage</p>
        }

        @if (ChatMessages.Count > 0)
        {
            <section id="@ChatLogId" class="home-chat" aria-live="polite" aria-label='@T["Home.ChatAria"]'>
                @foreach (var message in ChatMessages)
                {
                    <article class="home-chat-message home-chat-message-@message.Role">
                        <span>@(message.Role == ChatRole.Assistant ? T["Home.ChatAssistant"] : T["Home.ChatUser"])</span>
                        @foreach (var paragraph in SplitMessageText(message.Text))
                        {
                            <p>@paragraph</p>
                        }
                        @if (message.Options.Count > 0)
                        {
                            <div class="home-chat-products" aria-label='@T["Home.ChatProductOptions"]'>
                                @foreach (var option in message.Options)
                                {
                                    <article class="home-chat-product" style="--accent:@option.Accent">
                                        <small>@option.Badge</small>
                                        <strong>@option.Name</strong>
                                        <span>@option.Price · @option.Brand</span>
                                        <p>@option.Summary</p>
                                        <ul>
                                            @foreach (var spec in option.Specs)
                                            {
                                                <li>@spec</li>
                                            }
                                        </ul>
                                        <button
                                            type="button"
                                            class="home-chat-product-action"
                                            @onclick="() => SelectSuggestedProduct(option)"
                                            disabled="@IsSubmitting"
                                            aria-label='@T.Format("Home.SelectSuggestionAria", option.Name)'>
                                            @T["Home.SelectSuggestion"]
                                        </button>
                                    </article>
                                }
                            </div>
                        }
                    </article>
                }
            </section>
        }

        <div class="category-menu" id="categories">
            @foreach (var category in Data.Categories)
            {
                <button type="button" class="@(category == ActiveCategory ? "active" : null)" @onclick="() => UseCategory(category)">
                    @category
                </button>
            }
        </div>
    </div>
</section>

<section class="capability-strip" aria-label='@T["Home.Capabilities"]'>
    <a href="results" style="--accent:#7BE8E0">
        <strong>@T["Home.Compare"]</strong>
        <span>@T["Home.Products"]</span>
    </a>
    <a href="product/macbook-air-m3" style="--accent:#5EE9A8">
        <strong>@T["Home.Verify"]</strong>
        <span>@T["Home.Authenticity"]</span>
    </a>
    <a href="checkout" style="--accent:#E97B7B">
        <strong>@T["Home.Choose"]</strong>
        <span>@T["Home.Seller"]</span>
    </a>
    <a href="checkout" style="--accent:#E9D67B">
        <strong>@T["Home.Buy"]</strong>
        <span>@T["Home.Now"]</span>
    </a>
    <a href="tutorials" style="--accent:#F0A36A">
        <strong>@T["Home.Master"]</strong>
        <span>@T["Home.Flows"]</span>
    </a>
</section>

@code {
    private const long MaxImageBytes = 5 * 1024 * 1024;
    private const string PromptPanelId = "home-prompt-panel";
    private const string ChatLogId = "home-chat-log";
    private const string PromptInputId = "prompt";
    private static readonly HashSet<string> AllowedImageContentTypes = new(StringComparer.OrdinalIgnoreCase)
    {
        "image/png",
        "image/jpeg",
        "image/webp"
    };

    private static readonly HashSet<string> AllowedImageExtensions = new(StringComparer.OrdinalIgnoreCase)
    {
        ".png",
        ".jpg",
        ".jpeg",
        ".webp"
    };

    private string Prompt { get; set; } = string.Empty;
    private string ActiveCategory { get; set; } = string.Empty;

    [SupplyParameterFromQuery(Name = "newChat")]
    public string? NewChatToken { get; set; }

    private string? AppliedNewChatToken { get; set; }
    private bool IsSubmitting { get; set; }
    private bool IsAnalyzingImage { get; set; }
    private bool IsPromptFocused { get; set; }
    private string? QuotaMessage { get; set; }
    private string? SelectedImageName { get; set; }
    private string? SelectedImagePreviewDataUrl { get; set; }
    private ImageProductSuggestionResult? ImageSuggestion { get; set; }
    private List<HomeChatMessage> ChatMessages { get; } = new();
    private bool ShouldRestorePromptFocus { get; set; }
    private bool ShouldScrollChatToEnd { get; set; }
    private IJSObjectReference? pasteImagesModule;
    private DotNetObjectReference<Home>? dotNetReference;
    private string PromptPlaceholder => IsPromptFocused ? string.Empty : T["Home.DefaultPrompt"];

    protected override void OnParametersSet()
    {
        if (string.IsNullOrWhiteSpace(NewChatToken)
            || string.Equals(NewChatToken, AppliedNewChatToken, StringComparison.Ordinal))
        {
            return;
        }

        AppliedNewChatToken = NewChatToken;
        ResetConversation();
    }

    private void ResetConversation()
    {
        Prompt = string.Empty;
        ActiveCategory = string.Empty;
        IsSubmitting = false;
        IsAnalyzingImage = false;
        IsPromptFocused = false;
        QuotaMessage = null;
        SelectedImageName = null;
        SelectedImagePreviewDataUrl = null;
        ImageSuggestion = null;
        ChatMessages.Clear();
        ShouldScrollChatToEnd = false;
        ShouldRestorePromptFocus = true;
    }

    private void HidePromptPlaceholder()
    {
        IsPromptFocused = true;
    }

    private void ShowPromptPlaceholder()
    {
        IsPromptFocused = false;
    }

    private void UseCategory(string category)
    {
        ActiveCategory = category;
        Prompt = T.Format("Home.CategoryPrompt", category);
    }

    private async Task HandlePromptKeyDown(KeyboardEventArgs args)
    {
        if (args.Key.Equals("Enter", StringComparison.OrdinalIgnoreCase))
        {
            await StartComparison();
        }
    }

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (firstRender)
        {
            dotNetReference = DotNetObjectReference.Create(this);
            pasteImagesModule = await JS.InvokeAsync<IJSObjectReference>("import", "./truecompare-paste-images.js?v=2");
            await pasteImagesModule.InvokeVoidAsync("connect", PromptPanelId, dotNetReference, MaxImageBytes);
        }

        if (pasteImagesModule is null)
        {
            return;
        }

        if (ShouldScrollChatToEnd)
        {
            ShouldScrollChatToEnd = false;
            await pasteImagesModule.InvokeVoidAsync("scrollToEnd", ChatLogId);
        }

        if (ShouldRestorePromptFocus)
        {
            ShouldRestorePromptFocus = false;
            await pasteImagesModule.InvokeVoidAsync("focusElement", PromptInputId);
        }
    }

    private async Task HandleImageSelected(InputFileChangeEventArgs args)
    {
        var file = args.File;
        if (file is null)
        {
            return;
        }

        if (file.Size > MaxImageBytes)
        {
            SelectedImagePreviewDataUrl = null;
            QuotaMessage = T["Home.ImageTooLarge"];
            return;
        }

        IsAnalyzingImage = true;
        try
        {
            await using var stream = file.OpenReadStream(MaxImageBytes);
            using var memoryStream = new MemoryStream();
            await stream.CopyToAsync(memoryStream);

            await AnalyzeImageBytesAsync(file.Name, file.ContentType, memoryStream.ToArray(), file.Size);
        }
        catch
        {
            QuotaMessage = T["Home.ImageAnalysisFailed"];
        }
        finally
        {
            IsAnalyzingImage = false;
        }
    }

    [JSInvokable]
    public async Task HandlePastedImageAsync(string fileName, string contentType, string base64Image, long size)
    {
        if (size > MaxImageBytes)
        {
            await HandlePastedImageRejectedAsync("too-large");
            return;
        }

        try
        {
            var imageBytes = Convert.FromBase64String(base64Image);
            await AnalyzeImageBytesAsync(fileName, contentType, imageBytes, size);
        }
        catch
        {
            QuotaMessage = T["Home.ImageAnalysisFailed"];
            await InvokeAsync(StateHasChanged);
        }
    }

    [JSInvokable]
    public Task HandlePastedImageRejectedAsync(string reason)
    {
        ImageSuggestion = null;
        SelectedImageName = null;
        SelectedImagePreviewDataUrl = null;
        QuotaMessage = reason.Equals("too-large", StringComparison.OrdinalIgnoreCase)
            ? T["Home.ImageTooLarge"]
            : T["Home.ImageInvalid"];

        return InvokeAsync(StateHasChanged);
    }

    private async Task AnalyzeImageBytesAsync(string fileName, string contentType, byte[] imageBytes, long size)
    {
        QuotaMessage = null;
        ImageSuggestion = null;
        SelectedImageName = string.IsNullOrWhiteSpace(fileName) ? T["Home.ImageSuggestion"] : fileName;

        if (!IsAllowedImage(fileName, contentType) || imageBytes.Length == 0)
        {
            SelectedImagePreviewDataUrl = null;
            QuotaMessage = T["Home.ImageInvalid"];
            return;
        }

        if (size > MaxImageBytes || imageBytes.LongLength > MaxImageBytes)
        {
            SelectedImagePreviewDataUrl = null;
            QuotaMessage = T["Home.ImageTooLarge"];
            return;
        }

        IsAnalyzingImage = true;
        await InvokeAsync(StateHasChanged);

        try
        {
            SelectedImagePreviewDataUrl = $"data:{contentType};base64,{Convert.ToBase64String(imageBytes)}";
            ImageSuggestion = await ImageSuggestionService.AnalyzeImageAsync(SelectedImageName, contentType, imageBytes);
            if (!string.IsNullOrWhiteSpace(ImageSuggestion.SuggestedQuery))
            {
                Prompt = ImageSuggestion.SuggestedQuery;
            }
        }
        finally
        {
            IsAnalyzingImage = false;
        }
    }

    private void ClearImageSuggestion()
    {
        SelectedImageName = null;
        SelectedImagePreviewDataUrl = null;
        ImageSuggestion = null;
        QuotaMessage = null;
    }

    private static bool IsAllowedImage(string fileName, string contentType)
    {
        if (!AllowedImageContentTypes.Contains(contentType))
        {
            return false;
        }

        var extension = Path.GetExtension(fileName);
        return string.IsNullOrWhiteSpace(extension) || AllowedImageExtensions.Contains(extension);
    }

    private async Task StartComparison()
    {
        if (IsSubmitting)
        {
            return;
        }

        if (IsAnalyzingImage)
        {
            QuotaMessage = T["Home.ImageAnalyzing"];
            return;
        }

        if (string.IsNullOrWhiteSpace(Prompt) && !string.IsNullOrWhiteSpace(ImageSuggestion?.SuggestedQuery))
        {
            Prompt = ImageSuggestion.SuggestedQuery;
        }

        if (string.IsNullOrWhiteSpace(Prompt))
        {
            QuotaMessage = null;
            AddAssistantMessage(T["Home.ChatEmpty"]);
            return;
        }

        var userPrompt = Prompt.Trim();
        var decision = Conversation.Evaluate(userPrompt);
        AddUserMessage(userPrompt);
        Prompt = string.Empty;
        QuotaMessage = null;

        if (!decision.CanProceed)
        {
            AddAssistantMessage(decision.AssistantMessage, decision.Options);
            return;
        }

        AddAssistantMessage(decision.AssistantMessage, decision.Options);
        await ProceedToResultsAsync(decision.ResolvedQuery);
    }

    private Task SelectSuggestedProduct(ProductConversationOption option)
    {
        if (IsSubmitting)
        {
            return Task.CompletedTask;
        }

        IsSubmitting = true;
        Navigation.NavigateTo($"/product/{Uri.EscapeDataString(option.Slug)}?query={Uri.EscapeDataString(option.Slug)}");
        return Task.CompletedTask;
    }

    private async Task ProceedToResultsAsync(string query)
    {
        IsSubmitting = true;

        var resultsUrl = $"/results?query={Uri.EscapeDataString(query)}";
        var authState = await AuthenticationStateProvider.GetAuthenticationStateAsync();
        var userId = authState.User.FindFirst(System.Security.Claims.ClaimTypes.NameIdentifier)?.Value;

        if (string.IsNullOrWhiteSpace(userId))
        {
            Navigation.NavigateTo($"/login?returnUrl={Uri.EscapeDataString(resultsUrl)}", forceLoad: true);
            return;
        }

        var result = await QuotaService.TryConsumeAsync(userId, query);
        if (!result.Allowed)
        {
            Navigation.NavigateTo($"/credits?returnUrl={Uri.EscapeDataString(resultsUrl)}&message={Uri.EscapeDataString(T["Home.NoCredits"])}", forceLoad: true);
            return;
        }

        Navigation.NavigateTo(resultsUrl);
    }

    private void AddUserMessage(string text)
    {
        AddChatMessage(ChatRole.User, text);
    }

    private void AddAssistantMessage(string text, IReadOnlyList<ProductConversationOption>? options = null)
    {
        AddChatMessage(ChatRole.Assistant, text, options);
    }

    private void AddChatMessage(string role, string text, IReadOnlyList<ProductConversationOption>? options = null)
    {
        if (string.IsNullOrWhiteSpace(text))
        {
            return;
        }

        ChatMessages.Add(new HomeChatMessage(role, text, options ?? Array.Empty<ProductConversationOption>()));
        ShouldScrollChatToEnd = true;
        ShouldRestorePromptFocus = true;
        if (ChatMessages.Count > 12)
        {
            ChatMessages.RemoveAt(0);
        }
    }

    private static IEnumerable<string> SplitMessageText(string text)
    {
        return text
            .Split('\n', StringSplitOptions.TrimEntries | StringSplitOptions.RemoveEmptyEntries)
            .DefaultIfEmpty(text);
    }

    public async ValueTask DisposeAsync()
    {
        if (pasteImagesModule is not null)
        {
            try
            {
                await pasteImagesModule.InvokeVoidAsync("disconnect", PromptPanelId);
                await pasteImagesModule.DisposeAsync();
            }
            catch (JSDisconnectedException)
            {
            }
        }

        dotNetReference?.Dispose();
    }

    private static class ChatRole
    {
        public const string Assistant = "assistant";
        public const string User = "user";
    }

    private sealed record HomeChatMessage(
        string Role,
        string Text,
        IReadOnlyList<ProductConversationOption> Options);
}
