@page "/product/{Slug}"
@inject IProductDiscoveryService DiscoveryService
@inject AppText T

<PageTitle>@T["Product.PageTitle"]</PageTitle>

@if (Product is null)
{
    <section class="empty-state">
        <h1>@T["Product.NotFound"]</h1>
        <a class="primary-button" href="results">@T["Product.Results"]</a>
    </section>
}
else
{
    <section class="page-header compact-header product-detail-header">
        <div>
            <h1>@T["Product.Title"]</h1>
        </div>
        <div class="product-header-actions">
            <a class="secondary-button compact" href="@ResultsUrl">@T["Product.Results"]</a>
            <a class="primary-button compact" href="@CheckoutUrl">@T["Product.Conditions"]</a>
        </div>
    </section>

    <div class="detail-grid product-detail-grid">
        <section class="product-summary">
            <h2>@Product.Name · @Product.Specs.FirstOrDefault()</h2>
            <p class="brand">@Product.Brand</p>

            <div class="summary-line">
                @foreach (var spec in Product.Specs.Take(3))
                {
                    <span>@spec</span>
                }
            </div>

            <div class="score-block">
                <span>@T["Product.Score"]</span>
                <strong>@Product.Score</strong>
                <em>@Product.Badge</em>
            </div>
        </section>

        <section class="analysis-panel flat">
            <h2>@T["Product.AiAnalysis"]</h2>
            <p>@Product.AiSummary</p>
        </section>

        @if (Product.LifecycleInfo is not null)
        {
            <section class="analysis-panel flat product-lifecycle-panel">
                <div>
                    <h2>@T["Product.LifecycleTitle"]</h2>
                </div>

                <dl class="official-spec-list product-lifecycle-list">
                    <div>
                        <dt>@T["Product.ReleaseYear"]</dt>
                        <dd>@Product.LifecycleInfo.ReleaseYear</dd>
                    </div>
                    <div>
                        <dt>@T["Product.VersionStatus"]</dt>
                        <dd>@Product.LifecycleInfo.VersionStatus</dd>
                    </div>
                    <div>
                        <dt>@T["Product.NewerVersion"]</dt>
                        <dd>@Product.LifecycleInfo.NewerVersion</dd>
                    </div>
                    <div>
                        <dt>@T["Product.NextRelease"]</dt>
                        <dd>@Product.LifecycleInfo.NextReleaseForecast</dd>
                    </div>
                </dl>

                @if (!string.IsNullOrWhiteSpace(Product.LifecycleInfo.SourceUrl))
                {
                    <a class="secondary-button compact evidence-link" href="@Product.LifecycleInfo.SourceUrl" target="_blank" rel="noopener noreferrer">
                        @T["Product.LifecycleSource"]: @Product.LifecycleInfo.SourceLabel
                    </a>
                }
                else
                {
                    <p class="product-lifecycle-source">@T["Product.LifecycleSource"]: @Product.LifecycleInfo.SourceLabel</p>
                }
            </section>
        }

        @if (Product.OfficialSource is not null && Product.OfficialSpecifications.Count > 0)
        {
            <section class="analysis-panel flat official-specs-panel">
                <div>
                    <h2>@T["Product.OfficialSpecs"]</h2>
                    <p>@Product.OfficialSource.Description</p>
                </div>

                <dl class="official-spec-list">
                    @foreach (var specification in Product.OfficialSpecifications)
                    {
                        <div>
                            <dt>@specification.Label</dt>
                            <dd>@specification.Value</dd>
                        </div>
                    }
                </dl>

                <a class="secondary-button compact evidence-link" href="@Product.OfficialSource.Url" target="_blank" rel="noopener noreferrer">
                    @T["Product.OpenOfficialPage"]
                </a>
            </section>
        }

        @if (Product.ReviewLinks.Count > 0)
        {
            <section class="analysis-panel flat review-panel">
                <div>
                    <h2>@T["Product.YouTubeReviews"]</h2>
                    <p>@T["Product.YouTubeReviewsLead"]</p>
                </div>

                <div class="review-list">
                    @foreach (var review in Product.ReviewLinks.Take(2))
                    {
                        <a class="review-card" href="@review.Url" target="_blank" rel="noopener noreferrer">
                            <span>@review.Channel</span>
                            <strong>@review.Title</strong>
                            <small>@review.ViewSignal</small>
                        </a>
                    }
                </div>
            </section>
        }

    </div>

}

@code {
    [Parameter]
    public string? Slug { get; set; }

    [SupplyParameterFromQuery]
    public string? Query { get; set; }

    private ProductResult? Product { get; set; }

    private string ResultsUrl => string.IsNullOrWhiteSpace(Query)
        ? "/results"
        : $"/results?query={Uri.EscapeDataString(Query)}";

    private string CheckoutUrl => Product is null
        ? "/checkout"
        : string.IsNullOrWhiteSpace(Query)
            ? $"/checkout?product={Uri.EscapeDataString(Product.Slug)}"
            : $"/checkout?product={Uri.EscapeDataString(Product.Slug)}&query={Uri.EscapeDataString(Query)}";

    protected override async Task OnParametersSetAsync()
    {
        Product = await DiscoveryService.FindProductAsync(Slug, Query);
    }
}
