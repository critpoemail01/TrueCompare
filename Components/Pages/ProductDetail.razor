@page "/product/{Slug}"
@using System.Security.Claims
@inject ComparisonDataService ComparisonData
@inject SearchResultSnapshotService SnapshotService
@inject AuthenticationStateProvider AuthenticationStateProvider
@inject NavigationManager Navigation
@inject AppText T

<PageTitle>@T["Product.PageTitle"]</PageTitle>

@if (Product is null)
{
    <section class="empty-state">
        <h1>@T["Product.NotFound"]</h1>
        <a class="primary-button" href="/">@T["Product.Results"]</a>
    </section>
}
else
{
    <section class="page-header compact-header product-detail-header">
        <div>
            <h1>@T["Product.Title"]</h1>
        </div>
        <div class="product-header-actions">
            <a class="secondary-button compact" href="@ResultsUrl">@T["Product.Results"]</a>
            <a class="primary-button compact" href="@CheckoutUrl">@T["Product.Conditions"]</a>
        </div>
    </section>

    <div class="detail-grid product-detail-grid">
        <section class="product-summary">
            <h2>@Product.Name · @Product.Specs.FirstOrDefault()</h2>
            <p class="brand">@Product.Brand</p>

            <div class="summary-line">
                @foreach (var spec in Product.Specs.Take(3))
                {
                    <span>@spec</span>
                }
            </div>

            <div class="score-block">
                <span>@T["Product.Score"]</span>
                <strong>@Product.Score</strong>
                <em>@Product.Badge</em>
            </div>
        </section>

        <section class="analysis-panel flat">
            <h2>@T["Product.AiAnalysis"]</h2>
            <p>@Product.AiSummary</p>
        </section>

        @if (StoreSearches.Count > 0)
        {
            <section class="analysis-panel flat product-store-suggestions-panel">
                <h2>@T["Product.SuggestedStores"]</h2>
                <p>@T["Product.SuggestedStoresLead"]</p>
                <div class="store-suggestion-list">
                    @foreach (var store in StoreSearches)
                    {
                        <a class="secondary-button compact" href="@store.Url" target="_blank" rel="noopener noreferrer">
                            @T.Format("Product.SearchStore", store.Seller)
                        </a>
                    }
                </div>
            </section>
        }

        @if (Product.LifecycleInfo is not null)
        {
            <section class="analysis-panel flat product-lifecycle-panel">
                <div>
                    <h2>@T["Product.LifecycleTitle"]</h2>
                </div>

                <dl class="official-spec-list product-lifecycle-list">
                    <div>
                        <dt>@T["Product.ReleaseYear"]</dt>
                        <dd>@Product.LifecycleInfo.ReleaseYear</dd>
                    </div>
                    <div>
                        <dt>@T["Product.VersionStatus"]</dt>
                        <dd>@Product.LifecycleInfo.VersionStatus</dd>
                    </div>
                    <div>
                        <dt>@T["Product.NewerVersion"]</dt>
                        <dd>@Product.LifecycleInfo.NewerVersion</dd>
                    </div>
                    <div>
                        <dt>@T["Product.NextRelease"]</dt>
                        <dd>@Product.LifecycleInfo.NextReleaseForecast</dd>
                    </div>
                </dl>

                @if (!string.IsNullOrWhiteSpace(Product.LifecycleInfo.SourceUrl))
                {
                    <a class="secondary-button compact evidence-link" href="@Product.LifecycleInfo.SourceUrl" target="_blank" rel="noopener noreferrer">
                        @T["Product.LifecycleSource"]: @Product.LifecycleInfo.SourceLabel
                    </a>
                }
                else
                {
                    <p class="product-lifecycle-source">@T["Product.LifecycleSource"]: @Product.LifecycleInfo.SourceLabel</p>
                }
            </section>
        }

        @if (Product.OfficialSource is not null && Product.OfficialSpecifications.Count > 0)
        {
            <section class="analysis-panel flat official-specs-panel">
                <div>
                    <h2>@T["Product.OfficialSpecs"]</h2>
                    <p>@Product.OfficialSource.Description</p>
                </div>

                <dl class="official-spec-list">
                    @foreach (var specification in Product.OfficialSpecifications)
                    {
                        <div>
                            <dt>@specification.Label</dt>
                            <dd>@specification.Value</dd>
                        </div>
                    }
                </dl>

                <a class="secondary-button compact evidence-link" href="@Product.OfficialSource.Url" target="_blank" rel="noopener noreferrer">
                    @T["Product.OpenOfficialPage"]
                </a>
            </section>
        }

        @if (Product.ReviewLinks.Count > 0)
        {
            <section class="analysis-panel flat review-panel">
                <div>
                    <h2>@T["Product.YouTubeReviews"]</h2>
                    <p>@T["Product.YouTubeReviewsLead"]</p>
                </div>

                <div class="review-list">
                    @foreach (var review in Product.ReviewLinks.Take(2))
                    {
                        <a class="review-card" href="@review.Url" target="_blank" rel="noopener noreferrer">
                            <span>@review.Channel</span>
                            <strong>@review.Title</strong>
                            <small>@review.ViewSignal</small>
                        </a>
                    }
                </div>
            </section>
        }

    </div>

}


@code {
    [Parameter]
    public string? Slug { get; set; }

    [SupplyParameterFromQuery]
    public string? Query { get; set; }

    [SupplyParameterFromQuery(Name = "requestId")]
    public string? RequestId { get; set; }

    private ProductResult? Product { get; set; }

    private IReadOnlyList<SellerOffer> StoreSearches { get; set; } = Array.Empty<SellerOffer>();

    private string ResultsUrl
    {
        get
        {
            var url = string.IsNullOrWhiteSpace(Query)
                ? "/"
                : $"/results?query={Uri.EscapeDataString(Query)}";

            if (!string.IsNullOrWhiteSpace(RequestId) && !url.Equals("/", StringComparison.Ordinal))
            {
                url += url.Contains('?') ? "&" : "?";
                url += $"requestId={Uri.EscapeDataString(RequestId)}";
            }

            return url;
        }
    }

    private string CheckoutUrl
    {
        get
        {
            if (Product is null)
            {
                return "/checkout";
            }

            var url = $"/checkout?product={Uri.EscapeDataString(Product.Slug)}";
            if (!string.IsNullOrWhiteSpace(Query))
            {
                url += $"&query={Uri.EscapeDataString(Query)}";
            }

            if (!string.IsNullOrWhiteSpace(RequestId))
            {
                url += $"&requestId={Uri.EscapeDataString(RequestId)}";
            }

            return url;
        }
    }

    protected override async Task OnParametersSetAsync()
    {
        Product = null;
        StoreSearches = Array.Empty<SellerOffer>();
        if (string.IsNullOrWhiteSpace(Slug))
        {
            return;
        }

        var localProduct = ComparisonData.FindProduct(Slug);
        if (string.IsNullOrWhiteSpace(Query) && string.IsNullOrWhiteSpace(RequestId))
        {
            SetProduct(localProduct);
            return;
        }

        var authState = await AuthenticationStateProvider.GetAuthenticationStateAsync();
        var userId = authState.User.FindFirst(ClaimTypes.NameIdentifier)?.Value;
        if (!string.IsNullOrWhiteSpace(userId) && !string.IsNullOrWhiteSpace(Query))
        {
            var snapshot = await LoadSnapshotAsync(userId, Query, RequestId);
            SetProduct(snapshot?.Products.FirstOrDefault(product => product.Slug.Equals(Slug, StringComparison.OrdinalIgnoreCase)));
            if (Product is not null)
            {
                return;
            }
        }

        SetProduct(ResolveLocalProductFromQuery(localProduct));
    }

    private void SetProduct(ProductResult? product)
    {
        Product = product;
        StoreSearches = product is null
            ? Array.Empty<SellerOffer>()
            : ComparisonData.GetSuggestedStoreSearches(product, Query ?? product.Slug, 4);
    }

    private ProductResult? ResolveLocalProductFromQuery(ProductResult? localProduct)
    {
        if (string.IsNullOrWhiteSpace(Query))
        {
            return localProduct;
        }

        var queryProducts = ComparisonData.GetProducts(Query);
        if (queryProducts.Count == 0)
        {
            return localProduct;
        }

        return queryProducts.FirstOrDefault(product => product.Slug.Equals(Slug, StringComparison.OrdinalIgnoreCase))
            ?? queryProducts.FirstOrDefault()
            ?? localProduct;
    }

    private async Task<SearchExecutionResult?> LoadSnapshotAsync(string userId, string query, string? requestId)
    {
        if (!string.IsNullOrWhiteSpace(requestId))
        {
            var rawKey = SearchOrchestratorService.BuildSearchIdempotencyKey(userId, query, requestId);
            var storageKey = SearchQuotaService.NormalizeIdempotencyKeyForStorage(rawKey, query);
            var snapshot = await SnapshotService.GetByIdempotencyKeyAsync(userId, storageKey, query);
            if (snapshot is not null)
            {
                return snapshot;
            }
        }

        return await SnapshotService.GetLatestForQueryAsync(userId, query);
    }
}
