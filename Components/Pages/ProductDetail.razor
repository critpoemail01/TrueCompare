@page "/product/{Slug}"
@inject ComparisonDataService Data
@inject AppText T

<PageTitle>@T["Product.PageTitle"]</PageTitle>

@if (Product is null)
{
    <section class="empty-state">
        <h1>@T["Product.NotFound"]</h1>
        <a class="primary-button" href="results">@T["Product.Results"]</a>
    </section>
}
else
{
    <section class="page-header compact-header">
        <div>
            <h1>@T["Product.Title"]</h1>
        </div>
    </section>

    <div class="detail-grid">
        <section class="product-summary">
            <h2>@Product.Name · @Product.Specs.FirstOrDefault()</h2>
            <p class="brand">@Product.Brand</p>

            <div class="summary-line">
                @foreach (var spec in Product.Specs.Take(3))
                {
                    <span>@spec</span>
                }
            </div>

            <div class="score-block">
                <span>@T["Product.Score"]</span>
                <strong>@Product.Score</strong>
                <em>@Product.Badge</em>
            </div>
        </section>

        <section class="analysis-panel flat">
            <h2>@T["Product.AiAnalysis"]</h2>
            <p>@Product.AiSummary</p>
        </section>

        <section class="checklist verified-panel">
            <h2>@T["Product.Verified"]</h2>
            <p class="muted-label">@T["Product.VerifiedLead"]</p>
            @foreach (var check in Product.VerificationChecks)
            {
                <p><span>✓</span>@check</p>
            }
        </section>

        <section class="alert-panel">
            <h2>@T["Product.FraudAlerts"]</h2>

            @if (Product.FraudAlerts.Count == 0)
            {
                <div class="safe-alert">@T["Product.Clean"]</div>
            }
            else
            {
                <div class="fraud-list">
                    @foreach (var alert in Product.FraudAlerts)
                    {
                        <div>
                            <span>✕ @alert.Source</span>
                            <strong>@alert.Reason</strong>
                        </div>
                    }
                </div>
            }
        </section>
    </div>
}

@code {
    [Parameter]
    public string? Slug { get; set; }

    [SupplyParameterFromQuery]
    public string? Query { get; set; }

    private ProductResult? Product { get; set; }

    private string CheckoutUrl => Product is null
        ? "/checkout"
        : $"/checkout?product={Uri.EscapeDataString(Product.Slug)}";

    protected override void OnParametersSet()
    {
        Product = string.IsNullOrWhiteSpace(Slug) ? null : Data.FindProduct(Slug);
    }
}
