@page "/register"
@inject AppText T

<PageTitle>@T["Auth.RegisterPageTitle"]</PageTitle>

<section class="auth-shell">
    <div class="auth-card">
        <p class="eyebrow">@T["Auth.FreeSearches"]</p>
        <h1>@T["Auth.RegisterTitle"]</h1>

        @if (!string.IsNullOrWhiteSpace(Message))
        {
            <div class="form-message">@Message</div>
        }

        <a class="google-button" href="@GoogleUrl">@T["Auth.CreateWithGoogle"]</a>

        <div class="divider"><span>@T["Auth.Or"]</span></div>

        <form method="post" action="/auth/register" class="auth-form">
            <AntiforgeryToken />
            <input type="hidden" name="ReturnUrl" value="@ReturnUrl" />

            <label>
                Email
                <input name="Email" type="email" autocomplete="email" required />
            </label>

            <label>
                @T["Auth.Password"]
                <input name="Password" type="password" autocomplete="new-password" minlength="10" required />
            </label>

            <label>
                @T["Auth.ConfirmPassword"]
                <input name="ConfirmPassword" type="password" autocomplete="new-password" minlength="10" required />
            </label>

            <button class="primary-button wide" type="submit">@T["Auth.CreateAccount"]</button>
        </form>

        <p class="auth-switch">@T["Auth.AlreadyHaveAccount"] <a href="@LoginUrl">@T["Auth.LoginButton"]</a></p>
    </div>
</section>

@code {
    [SupplyParameterFromQuery]
    public string? ReturnUrl { get; set; }

    [SupplyParameterFromQuery]
    public string? Message { get; set; }

    private string GoogleUrl => $"/auth/google?returnUrl={Uri.EscapeDataString(ReturnUrl ?? "/")}";

    private string LoginUrl => $"/login?returnUrl={Uri.EscapeDataString(ReturnUrl ?? "/")}";
}
