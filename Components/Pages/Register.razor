@page "/register"

<PageTitle>Criar conta - TrueCompare</PageTitle>

<section class="auth-shell">
    <div class="auth-card">
        <p class="eyebrow">3 pesquisas gratuitas</p>
        <h1>Criar conta</h1>

        @if (!string.IsNullOrWhiteSpace(Message))
        {
            <div class="form-message">@Message</div>
        }

        <a class="google-button" href="@GoogleUrl">Criar com Gmail</a>

        <div class="divider"><span>ou</span></div>

        <form method="post" action="/auth/register" class="auth-form">
            <AntiforgeryToken />
            <input type="hidden" name="ReturnUrl" value="@ReturnUrl" />

            <label>
                Email
                <input name="Email" type="email" autocomplete="email" required />
            </label>

            <label>
                Password
                <input name="Password" type="password" autocomplete="new-password" minlength="10" required />
            </label>

            <label>
                Confirmar password
                <input name="ConfirmPassword" type="password" autocomplete="new-password" minlength="10" required />
            </label>

            <button class="primary-button wide" type="submit">Criar conta</button>
        </form>

        <p class="auth-switch">Já tens conta? <a href="@LoginUrl">Entrar</a></p>
    </div>
</section>

@code {
    [SupplyParameterFromQuery]
    public string? ReturnUrl { get; set; }

    [SupplyParameterFromQuery]
    public string? Message { get; set; }

    private string GoogleUrl => $"/auth/google?returnUrl={Uri.EscapeDataString(ReturnUrl ?? "/")}";

    private string LoginUrl => $"/login?returnUrl={Uri.EscapeDataString(ReturnUrl ?? "/")}";
}
