@page "/tutorials"
@inject ComparisonDataService Data
@inject AppText T

<PageTitle>@T["Tutorials.PageTitle"]</PageTitle>

<section class="page-header">
    <h1>@T["Tutorials.Title"]</h1>
    <p>@T["Tutorials.Lead"]</p>
</section>

<div class="filter-row" role="tablist" aria-label='@T["Tutorials.FilterAria"]'>
    @foreach (var filter in Filters)
    {
        <button type="button" class="@(ActiveFilter == filter ? "active" : null)" @onclick="() => ActiveFilter = filter">@filter</button>
    }
</div>

<section class="tutorial-grid">
    @foreach (var tutorial in FilteredTutorials)
    {
        <article class="tutorial-card">
            <div class="video-thumb">
                <span class="play-button">▶</span>
                <span class="duration">@tutorial.Duration</span>
            </div>
            <span class="tutorial-category">@tutorial.Category</span>
            <h2>@tutorial.Title</h2>
        </article>
    }
</section>

@code {
    private string ActiveFilter { get; set; } = string.Empty;

    private IReadOnlyList<string> Filters => new[] { T["Tutorials.All"], T["Tutorials.Beginners"], T["Tutorials.Advanced"], T["Tutorials.Security"], T["Tutorials.Orders"] };

    private IEnumerable<TutorialItem> FilteredTutorials => ActiveFilter == T["Tutorials.All"]
        ? Data.Tutorials
        : Data.Tutorials.Where(tutorial => tutorial.Category == ActiveFilter);

    protected override void OnInitialized()
    {
        ActiveFilter = T["Tutorials.All"];
    }
}
