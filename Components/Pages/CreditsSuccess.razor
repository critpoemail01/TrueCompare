@page "/credits/success"
@attribute [Authorize]
@inject AppText T

<PageTitle>@T["Credits.SuccessPageTitle"]</PageTitle>

<section class="empty-state">
    <p class="eyebrow">@T["Credits.SuccessEyebrow"]</p>
    <h1>@T["Credits.SuccessTitle"]</h1>
    <p>@T["Credits.SuccessLead"]</p>
    <a class="primary-button" href="credits">@T["Credits.ViewCredits"]</a>
</section>
