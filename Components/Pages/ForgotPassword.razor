@page "/forgot-password"
@inject AppText T

<PageTitle>@T.Pick("Recuperar password - TrueCompare", "Recover password - TrueCompare")</PageTitle>

<section class="auth-shell">
    <div class="auth-card">
        <p class="eyebrow">@T.Pick("Segurança", "Security")</p>
        <h1>@T.Pick("Recuperar password", "Recover password")</h1>

        @if (!string.IsNullOrWhiteSpace(Message))
        {
            <div class="form-message">@Message</div>
        }

        <form method="post" action="/auth/forgot-password" class="auth-form">
            <AntiforgeryToken />
            <label>
                Email
                <input name="Email" type="email" autocomplete="email" required />
            </label>

            <button class="primary-button wide" type="submit">@T.Pick("Enviar link de recuperação", "Send recovery link")</button>
        </form>

        <p class="auth-switch"><a href="/login">@T.Pick("Voltar ao login", "Back to login")</a></p>
    </div>
</section>

@code {
    [SupplyParameterFromQuery]
    public string? Message { get; set; }
}
