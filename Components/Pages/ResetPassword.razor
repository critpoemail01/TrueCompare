@page "/reset-password"
@inject AppText T

<PageTitle>@T.Pick("Redefinir password - TrueCompare", "Reset password - TrueCompare")</PageTitle>

<section class="auth-shell">
    <div class="auth-card">
        <p class="eyebrow">@T.Pick("Segurança", "Security")</p>
        <h1>@T.Pick("Redefinir password", "Reset password")</h1>

        @if (!string.IsNullOrWhiteSpace(Message))
        {
            <div class="form-message">@Message</div>
        }

        @if (string.IsNullOrWhiteSpace(UserId) || string.IsNullOrWhiteSpace(Token))
        {
            <p>@T.Pick("O link de recuperação é inválido ou está incompleto.", "The recovery link is invalid or incomplete.")</p>
            <p class="auth-switch"><a href="/forgot-password">@T.Pick("Pedir novo link", "Request a new link")</a></p>
        }
        else
        {
            <form method="post" action="/auth/reset-password" class="auth-form">
                <AntiforgeryToken />
                <input type="hidden" name="UserId" value="@UserId" />
                <input type="hidden" name="Token" value="@Token" />

                <label>
                    @T["Auth.Password"]
                    <input name="Password" type="password" autocomplete="new-password" minlength="10" required />
                </label>

                <label>
                    @T["Auth.ConfirmPassword"]
                    <input name="ConfirmPassword" type="password" autocomplete="new-password" minlength="10" required />
                </label>

                <button class="primary-button wide" type="submit">@T.Pick("Guardar nova password", "Save new password")</button>
            </form>
        }
    </div>
</section>

@code {
    [SupplyParameterFromQuery]
    public string? UserId { get; set; }

    [SupplyParameterFromQuery]
    public string? Token { get; set; }

    [SupplyParameterFromQuery]
    public string? Message { get; set; }
}
