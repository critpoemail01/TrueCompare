@page "/login"
@inject AppText T

<PageTitle>@T["Auth.LoginPageTitle"]</PageTitle>

<section class="auth-shell">
    <div class="auth-card">
        <p class="eyebrow">@T["Auth.LoginEyebrow"]</p>
        <h1>@T["Auth.LoginTitle"]</h1>

        @if (!string.IsNullOrWhiteSpace(Message))
        {
            <div class="form-message">@Message</div>
        }

        <a class="google-button" href="@GoogleUrl">@T["Auth.LoginWithGoogle"]</a>

        <div class="divider"><span>@T["Auth.Or"]</span></div>

        <form method="post" action="/auth/login" class="auth-form">
            <AntiforgeryToken />
            <input type="hidden" name="ReturnUrl" value="@ReturnUrl" />

            <label>
                Email
                <input name="Email" type="email" autocomplete="email" required />
            </label>

            <label>
                @T["Auth.Password"]
                <input name="Password" type="password" autocomplete="current-password" required />
            </label>

            <label class="check-line">
                <input name="RememberMe" type="checkbox" value="true" />
                @T["Auth.RememberMe"]
            </label>

            <button class="primary-button wide" type="submit">@T["Auth.LoginButton"]</button>
        </form>

        <p class="auth-switch"><a href="/forgot-password">@T.Pick("Esqueceste-te da password?", "Forgot your password?")</a></p>
        <p class="auth-switch">@T["Auth.NoAccount"] <a href="@RegisterUrl">@T["Auth.CreateAccount"]</a></p>
    </div>
</section>

@code {
    [SupplyParameterFromQuery]
    public string? ReturnUrl { get; set; }

    [SupplyParameterFromQuery]
    public string? Message { get; set; }

    private string GoogleUrl => $"/auth/google?returnUrl={Uri.EscapeDataString(ReturnUrl ?? "/")}";

    private string RegisterUrl => $"/register?returnUrl={Uri.EscapeDataString(ReturnUrl ?? "/")}";
}
