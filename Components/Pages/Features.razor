@page "/features"
@inject ComparisonDataService Data
@inject AppText T

<PageTitle>@T["Features.PageTitle"]</PageTitle>

<section class="page-header">
    <h1>@T["Features.Title"]</h1>
    <p>@T["Features.Lead"]</p>
</section>

<section class="feature-grid">
    @foreach (var feature in Data.Features)
    {
        <article class="feature-tile" style="--accent:@feature.Accent">
            <span>@feature.Number</span>
            <h2>@feature.Title</h2>
            <p>@feature.Description</p>
        </article>
    }
</section>
