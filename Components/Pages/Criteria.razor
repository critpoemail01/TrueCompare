@page "/criteria"
@inject NavigationManager Navigation

@code {
    [SupplyParameterFromQuery]
    public string? Query { get; set; }

    private bool redirected;

    protected override void OnParametersSet()
    {
        if (redirected)
        {
            return;
        }

        redirected = true;
        var resultsUrl = string.IsNullOrWhiteSpace(Query)
            ? "/"
            : $"/results?query={Uri.EscapeDataString(Query)}&requestId={Guid.NewGuid():N}";

        Navigation.NavigateTo(resultsUrl, replace: true);
    }
}
