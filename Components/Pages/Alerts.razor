@page "/alerts"
@attribute [Authorize]
@inject AuthenticationStateProvider AuthenticationStateProvider
@inject TargetPriceAlertService AlertService
@inject AppText T

<PageTitle>@T["Alerts.PageTitle"]</PageTitle>

<section class="page-header compact-header alerts-header">
    <div>
        <p class="eyebrow">@T["Alerts.Eyebrow"]</p>
        <h1>@T["Alerts.Title"]</h1>
        <p>@T["Alerts.Lead"]</p>
    </div>
    <div class="alerts-header-actions">
        @if (ActiveAlerts is not null && ActiveAlerts.Count > 0)
        {
            <span class="alert-count-pill">@AlertCountText</span>
        }
        <a class="secondary-button compact" href="/">@T["Credits.NewSearch"]</a>
    </div>
</section>

@if (ActiveAlerts is null)
{
    <p class="muted-label">@T["Alerts.Loading"]</p>
}
else if (ActiveAlerts.Count == 0)
{
    <section class="empty-state">
        <h2>@T["Alerts.EmptyTitle"]</h2>
        <p>@T["Alerts.EmptyLead"]</p>
    </section>
}
else
{
    <section class="alerts-list" aria-label='@T["Alerts.Title"]'>
        @foreach (var alert in ActiveAlerts)
        {
            <article class="alert-card">
                <div class="alert-card-copy">
                    <div class="alert-card-kicker">
                        <span>@T["Alerts.TargetPrice"]</span>
                        <time datetime="@alert.CreatedUtc.ToString("O")">@FormatDate(alert.CreatedUtc)</time>
                    </div>
                    <h2>@alert.ProductName</h2>
                    <p>@T.Format("Alerts.CurrentSeller", alert.LastSeenSeller ?? T["Alerts.NoSeller"])</p>

                    <div class="alert-progress" aria-label='@T["Alerts.Progress"]'>
                        <span style="@ProgressStyle(alert)"></span>
                    </div>
                    <small>@DifferenceText(alert)</small>
                </div>

                <dl class="alert-metric-grid">
                    <div>
                        <dt>@T["Alerts.Target"]</dt>
                        <dd>@TargetPriceAlertService.FormatCents(alert.TargetPriceCents)</dd>
                    </div>
                    <div>
                        <dt>@T["Alerts.LastSeen"]</dt>
                        <dd>@TargetPriceAlertService.FormatCents(alert.LastSeenPriceCents)</dd>
                    </div>
                    <div>
                        <dt>@T["Alerts.Distance"]</dt>
                        <dd>@DifferenceAmount(alert)</dd>
                    </div>
                </dl>

                <div class="alert-card-actions">
                    <a class="primary-button compact" href="@CheckoutUrl(alert.ProductSlug)">@T["Alerts.OpenProduct"]</a>
                    @if (!string.IsNullOrWhiteSpace(alert.ProductUrl))
                    {
                        <a class="secondary-button compact" href="@alert.ProductUrl" target="_blank" rel="noopener noreferrer">@T["Alerts.OpenStore"]</a>
                    }
                </div>
            </article>
        }
    </section>
}

@code {
    private IReadOnlyList<PriceAlertListItem>? ActiveAlerts { get; set; }

    private string AlertCountText => ActiveAlerts?.Count == 1
        ? T["Alerts.ActiveCountSingle"]
        : T.Format("Alerts.ActiveCount", ActiveAlerts?.Count ?? 0);

    protected override async Task OnInitializedAsync()
    {
        var authState = await AuthenticationStateProvider.GetAuthenticationStateAsync();
        var userId = authState.User.FindFirst(System.Security.Claims.ClaimTypes.NameIdentifier)?.Value;
        ActiveAlerts = string.IsNullOrWhiteSpace(userId)
            ? []
            : await AlertService.GetActiveForUserAsync(userId);
    }

    private static string CheckoutUrl(string productSlug)
    {
        return $"/checkout?product={Uri.EscapeDataString(productSlug)}";
    }

    private static string FormatDate(DateTime value)
    {
        return value.ToLocalTime().ToString("dd/MM/yyyy HH:mm", System.Globalization.CultureInfo.CurrentCulture);
    }

    private string DifferenceText(PriceAlertListItem alert)
    {
        var difference = alert.LastSeenPriceCents - alert.TargetPriceCents;
        return difference <= 0
            ? T["Alerts.TargetReached"]
            : T.Format("Alerts.Remaining", TargetPriceAlertService.FormatCents(difference));
    }

    private static string DifferenceAmount(PriceAlertListItem alert)
    {
        var difference = alert.LastSeenPriceCents - alert.TargetPriceCents;
        return difference <= 0
            ? TargetPriceAlertService.FormatCents(0)
            : TargetPriceAlertService.FormatCents(difference);
    }

    private static string ProgressStyle(PriceAlertListItem alert)
    {
        if (alert.LastSeenPriceCents <= 0)
        {
            return "width: 0%";
        }

        var progress = alert.LastSeenPriceCents <= alert.TargetPriceCents
            ? 100
            : Math.Clamp((int)Math.Round(alert.TargetPriceCents * 100m / alert.LastSeenPriceCents), 8, 100);

        return $"width: {progress}%";
    }
}
