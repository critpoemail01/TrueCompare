@page "/checkout"
@using System.Globalization
@using System.Security.Claims
@using Microsoft.AspNetCore.RateLimiting
@attribute [Authorize]
@attribute [EnableRateLimiting("search")]
@inject ComparisonDataService ComparisonData
@inject IStoreOfferValidationService StoreOfferValidator
@inject SearchResultSnapshotService SnapshotService
@inject SearchMarketContextService SearchMarket
@inject AuthenticationStateProvider AuthenticationStateProvider
@inject NavigationManager Navigation
@inject ILogger<Checkout> Logger
@inject AppText T
<PageTitle>@T["Checkout.PageTitle"]</PageTitle>

<section class="page-header checkout-header">
    <div class="checkout-header-top">
        <h1>@T["Checkout.Title"]</h1>
        <a class="secondary-button compact checkout-back-link" href="@ProductUrl">@T["Checkout.BackToProduct"]</a>
    </div>
    <p class="checkout-product-context">
        <span>@T["Checkout.ProductLabel"]</span>
        <strong>@ProductDisplayName</strong>
    </p>
    <p>@T["Checkout.Lead"]</p>
</section>

@if (!string.IsNullOrWhiteSpace(Message))
{
    <div class="form-message">@Message</div>
}

@if (Offers.Count == 0)
{
    <section class="empty-state checkout-empty-state">
        <h2>@T["Checkout.NoConfirmedOfferTitle"]</h2>
        <p>@T["Checkout.NoConfirmedOfferLead"]</p>
        @if (StoreSearches.Count > 0)
        {
            <div class="checkout-fallback-search">
                <p>@T["Checkout.SuggestedStoreSearchesLead"]</p>
                <div class="store-suggestion-list">
                    @foreach (var store in StoreSearches)
                    {
                        <a class="secondary-button compact" href="@store.Url" target="_blank" rel="noopener noreferrer">
                            @T.Format("Checkout.SearchStore", store.Seller)
                        </a>
                    }
                </div>
            </div>
        }
        @if (CanShowKuantoKustaFallback && !StoreSearches.Any(store => store.Seller.Contains("KuantoKusta", StringComparison.OrdinalIgnoreCase)))
        {
            <div class="checkout-fallback-search">
                <p>@T["Checkout.KuantoKustaFallbackLead"]</p>
                <a class="primary-button compact" href="@KuantoKustaSearchUrl" target="_blank" rel="noopener noreferrer">
                    @T["Checkout.SearchKuantoKusta"]
                </a>
            </div>
        }
        <div class="checkout-empty-actions">
            <a class="secondary-button compact" href="@ResultsUrl">@T["Checkout.BackToResults"]</a>
        </div>
    </section>
}
else if (SelectedOffer is not null)
{
    <div class="checkout-grid">
        <section class="seller-table-wrap">
            <table class="seller-table">
                <thead>
                    <tr>
                        <th>@T["Checkout.Seller"]</th>
                        <th>@T["Checkout.Price"]</th>
                        <th>@T["Checkout.Delivery"]</th>
                        <th>@T["Checkout.Warranty"]</th>
                        <th>@T["Checkout.Trust"]</th>
                        <th>@T["Checkout.Status"]</th>
                        <th>@T["Checkout.StoreAction"]</th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var offer in Offers)
                    {
                        <tr class="@(SelectedOffer == offer ? "selected" : null)" @onclick="() => SelectedOffer = offer">
                            <td data-label="@T["Checkout.Seller"]">
                                @offer.Seller
                                @if (offer.Preferred)
                                {
                                    <span class="recommended-label">@T["Checkout.BestPrice"]</span>
                                }
                                @if (!string.IsNullOrWhiteSpace(offer.Evidence))
                                {
                                    <small class="offer-evidence">@offer.Evidence</small>
                                }
                            </td>
                            <td data-label="@T["Checkout.Price"]">@DisplayPrice(offer)</td>
                            <td data-label="@T["Checkout.Delivery"]">@offer.Delivery</td>
                            <td data-label="@T["Checkout.Warranty"]">@offer.Warranty</td>
                            <td data-label="@T["Checkout.Trust"]">@TrustLabel(offer)</td>
                            <td data-label="@T["Checkout.Status"]"><span class="status-pill">&#10003; @offer.Status</span></td>
                            <td data-label="@T["Checkout.StoreAction"]">
                                <a class="secondary-button compact" href="@offer.Url" target="_blank" rel="noopener noreferrer" @onclick:stopPropagation="true">
                                    @T["Checkout.OpenStoreShort"]
                                </a>
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        </section>

        <aside class="checkout-side">
            <section class="order-panel">
                <h2>@T["Checkout.RecommendedSeller"]</h2>
                <p>@T["Checkout.ProtectedLead"]</p>

                <div class="selected-offer">
                    <strong>@SelectedOffer.Seller</strong>
                    <span>@T.Format("Checkout.SelectedOfferLine", DisplayPrice(SelectedOffer), SelectedOffer.Delivery)</span>
                    <small>@OfferTrustLine(SelectedOffer)</small>
                    <small>@PriceConfidenceLine(SelectedOffer)</small>
                    @if (!string.IsNullOrWhiteSpace(SelectedOffer.Evidence))
                    {
                        <small>@SelectedOffer.Evidence</small>
                    }
                </div>

                <dl class="totals-list">
                    <div>
                        <dt>@T["Checkout.Subtotal"]</dt>
                        <dd>@DisplayTotal</dd>
                    </div>
                    <div>
                        <dt>@T["Checkout.Shipping"]</dt>
                        <dd>@DisplayShipping</dd>
                    </div>
                    <div>
                        <dt>@T["Checkout.TrueCompareInsurance"]</dt>
                        <dd>@T["Checkout.Included"]</dd>
                    </div>
                    <div>
                        <dt>@T["Checkout.Vat"]</dt>
                        <dd>@DisplayVat</dd>
                    </div>
                    <div class="total">
                        <dt>@T["Checkout.Total"]</dt>
                        <dd>@DisplayTotal</dd>
                    </div>
                </dl>

                <div class="checkout-action-tabs" aria-label="@T["Checkout.ChooseAction"]">
                    <input class="checkout-action-tab" id="checkout-action-buy" name="checkout-action" type="radio" checked />
                    <label for="checkout-action-buy">
                        <strong>@T["Checkout.BuyMode"]</strong>
                        <span>@T["Checkout.BuyModeLead"]</span>
                    </label>

                    <input class="checkout-action-tab" id="checkout-action-alert" name="checkout-action" type="radio" />
                    <label for="checkout-action-alert">
                        <strong>@T["Checkout.AlertMode"]</strong>
                        <span>@T["Checkout.AlertModeLead"]</span>
                    </label>

                    <div class="checkout-action-panel checkout-buy-panel">
                        <a class="primary-button wide" href="@SelectedOffer.Url" target="_blank" rel="noopener noreferrer">
                            @PrimaryActionText
                        </a>

                        <p class="secure-payment-note">@SecurePaymentNote</p>
                    </div>

                    <div class="checkout-action-panel checkout-alert-panel">
                        <form method="post" action="/price-alerts/create" class="target-alert-form">
                            <AntiforgeryToken />
                            <input type="hidden" name="ProductSlug" value="@CheckoutProductSlug" />
                            <input type="hidden" name="ReturnUrl" value="@ReturnUrl" />
                            <label>
                                @T["Checkout.TargetPrice"]
                                <span>
                                    <input name="TargetPrice" type="number" min="1" step="0.01" value="@DefaultTargetPrice" required />
                                    <b>&euro;</b>
                                </span>
                            </label>
                            <button class="primary-button" type="submit">@T["Checkout.NotifyMe"]</button>
                        </form>
                    </div>
                </div>
            </section>
        </aside>
    </div>
}


@code {
    [SupplyParameterFromQuery]
    public string? Message { get; set; }

    [SupplyParameterFromQuery(Name = "product")]
    public string? ProductSlug { get; set; }

    [SupplyParameterFromQuery]
    public string? Query { get; set; }

    [SupplyParameterFromQuery(Name = "requestId")]
    public string? RequestId { get; set; }

    private string ResolvedProductSlug => ProductSlug?.Trim() ?? string.Empty;

    private ProductResult? Product { get; set; }

    private string CheckoutProductSlug => Product?.Slug ?? ResolvedProductSlug;

    private string ProductDisplayName => Product?.Name
        ?? (string.IsNullOrWhiteSpace(ResolvedProductSlug)
            ? T.Pick("Nenhum produto selecionado", "No product selected")
            : HumanizeProductSlug(ResolvedProductSlug));

    private IReadOnlyList<SellerOffer> Offers { get; set; } = Array.Empty<SellerOffer>();

    private IReadOnlyList<SellerOffer> StoreSearches { get; set; } = Array.Empty<SellerOffer>();

    private string ReturnUrl
    {
        get
        {
            var url = string.IsNullOrWhiteSpace(CheckoutProductSlug)
                ? "/checkout"
                : $"/checkout?product={Uri.EscapeDataString(CheckoutProductSlug)}";
            if (!string.IsNullOrWhiteSpace(Query))
            {
                url += url.Contains('?') ? "&" : "?";
                url += $"query={Uri.EscapeDataString(Query)}";
            }

            if (!string.IsNullOrWhiteSpace(RequestId))
            {
                url += url.Contains('?') ? "&" : "?";
                url += $"requestId={Uri.EscapeDataString(RequestId)}";
            }

            return url;
        }
    }

    private string ResultsUrl
    {
        get
        {
            var url = string.IsNullOrWhiteSpace(Query)
                ? "/"
                : $"/results?query={Uri.EscapeDataString(Query)}";

            if (!string.IsNullOrWhiteSpace(RequestId) && !url.Equals("/", StringComparison.Ordinal))
            {
                url += url.Contains('?') ? "&" : "?";
                url += $"requestId={Uri.EscapeDataString(RequestId)}";
            }

            return url;
        }
    }

    private string ProductUrl
    {
        get
        {
            if (Product is null && string.IsNullOrWhiteSpace(ResolvedProductSlug))
            {
                return "/";
            }

            var url = $"/product/{Uri.EscapeDataString(Product?.Slug ?? ResolvedProductSlug)}";
            if (!string.IsNullOrWhiteSpace(Query))
            {
                url += $"?query={Uri.EscapeDataString(Query)}";
            }

            if (!string.IsNullOrWhiteSpace(RequestId))
            {
                url += url.Contains('?') ? "&" : "?";
                url += $"requestId={Uri.EscapeDataString(RequestId)}";
            }

            return url;
        }
    }

    private bool CanShowKuantoKustaFallback => SearchMarket.Current().MarketCode.Equals("PT", StringComparison.OrdinalIgnoreCase);

    private string KuantoKustaSearchUrl => $"https://www.kuantokusta.pt/search?q={Uri.EscapeDataString(ProductDisplayName)}";

    private string DefaultTargetPrice => FormatPriceInputValue(CalculateDefaultTargetPriceCents(SelectedOffer));

    private SellerOffer? SelectedOffer { get; set; }

    private string FormattedTotal => FormatCurrency(SelectedOffer?.PriceCents ?? 0);

    private string VatValue => FormatCurrency((long)Math.Round((SelectedOffer?.PriceCents ?? 0) * 23m / 123m, MidpointRounding.AwayFromZero));

    private string DisplayTotal => SelectedOffer?.IsLiveValidated == true ? FormattedTotal : T["Checkout.PriceToConfirm"];

    private string DisplayVat => SelectedOffer?.IsLiveValidated == true ? VatValue : T["Checkout.PriceToConfirm"];

    private string DisplayShipping => SelectedOffer is null
        ? T["Checkout.PriceToConfirm"]
        : ShippingDisplay(SelectedOffer);

    private string PrimaryActionText => SelectedOffer?.IsLiveValidated == true
        ? T["Checkout.OpenStore"]
        : T["Checkout.ConfirmStorePrice"];

    private string SecurePaymentNote => SelectedOffer?.IsLiveValidated == true
        ? T["Checkout.SecurePayment"]
        : T["Checkout.EstimatedPriceWarning"];

    protected override async Task OnParametersSetAsync()
    {
        Product = null;
        Offers = Array.Empty<SellerOffer>();
        StoreSearches = Array.Empty<SellerOffer>();
        SelectedOffer = null;

        var authState = await AuthenticationStateProvider.GetAuthenticationStateAsync();
        var userId = authState.User.FindFirst(ClaimTypes.NameIdentifier)?.Value;
        if (string.IsNullOrWhiteSpace(userId))
        {
            Navigation.NavigateTo($"/login?returnUrl={Uri.EscapeDataString(ReturnUrl)}", forceLoad: true);
            return;
        }

        if (string.IsNullOrWhiteSpace(ResolvedProductSlug) && string.IsNullOrWhiteSpace(Query))
        {
            Message = T.Pick(
                "Seleciona um produto antes de abrir o checkout. Esta página não valida lojas sem produto explícito.",
                "Select a product before opening checkout. This page does not validate stores without an explicit product.");
            return;
        }

        if (!string.IsNullOrWhiteSpace(Query))
        {
            var snapshot = await LoadSnapshotAsync(userId, Query, RequestId);
            var snapshotSummary = ResolveSnapshotSummary(snapshot);
            if (snapshotSummary is not null)
            {
                Product = snapshotSummary.Product;
                Offers = snapshotSummary.Offers;
                StoreSearches = ComparisonData.GetSuggestedStoreSearches(Product, Query ?? Product.Slug);
                SelectBestOffer();
                return;
            }
        }

        Product = ComparisonData.FindProduct(ResolvedProductSlug);
        if (Product is null)
        {
            Logger.LogWarning("Checkout requested unknown product {ProductSlug} without a reusable search snapshot.", ResolvedProductSlug);
            return;
        }

        var storeCandidates = ComparisonData.GetSellerOffers(Product.Slug)
            .Take(6)
            .ToList();
        StoreSearches = ComparisonData.GetSuggestedStoreSearches(Product, Query ?? Product.Slug);
        var directCandidates = storeCandidates
            .Where(ComparisonDataService.IsConfirmedStoreOffer)
            .ToList();
        var validatedOffers = await StoreOfferValidator.ValidateConfirmedOffersAsync(Product, directCandidates);
        Offers = MergeValidatedOffersWithStoreCandidates(validatedOffers, storeCandidates);
        SelectBestOffer();
    }

    private SearchProductOfferSummary? ResolveSnapshotSummary(SearchExecutionResult? snapshot)
    {
        if (snapshot is null || snapshot.ProductOfferSummaries.Count == 0)
        {
            return null;
        }

        if (!string.IsNullOrWhiteSpace(ProductSlug)
            && snapshot.ProductOfferSummaries.TryGetValue(ProductSlug, out var summary))
        {
            return summary;
        }

        return snapshot.ProductOfferSummaries.Values.FirstOrDefault();
    }

    private async Task<SearchExecutionResult?> LoadSnapshotAsync(string userId, string query, string? requestId)
    {
        if (!string.IsNullOrWhiteSpace(requestId))
        {
            var rawKey = SearchOrchestratorService.BuildSearchIdempotencyKey(userId, query, requestId);
            var storageKey = SearchQuotaService.NormalizeIdempotencyKeyForStorage(rawKey, query);
            var snapshot = await SnapshotService.GetByIdempotencyKeyAsync(userId, storageKey, query);
            if (snapshot is not null)
            {
                return snapshot;
            }
        }

        return await SnapshotService.GetLatestForQueryAsync(userId, query);
    }

    private static IReadOnlyList<SellerOffer> MergeValidatedOffersWithStoreCandidates(
        IReadOnlyList<SellerOffer> validatedOffers,
        IReadOnlyList<SellerOffer> storeCandidates)
    {
        var merged = validatedOffers.ToList();
        foreach (var candidate in storeCandidates)
        {
            if (merged.Any(offer => offer.Seller.Equals(candidate.Seller, StringComparison.OrdinalIgnoreCase)))
            {
                continue;
            }

            merged.Add(candidate with
            {
                Preferred = false,
                ValidationState = candidate.IsLivePrice
                    ? OfferPriceValidationState.ValidationFailed
                    : OfferPriceValidationState.PendingValidation
            });
        }

        return merged
            .OrderByDescending(offer => offer.IsLiveValidated)
            .ThenByDescending(offer => offer.Preferred)
            .ThenBy(offer => offer.IsLiveValidated ? offer.PriceCents : long.MaxValue)
            .ThenByDescending(offer => offer.ReliabilityScore)
            .Take(6)
            .ToList();
    }

    private void SelectBestOffer()
    {
        SelectedOffer = Offers
            .OrderByDescending(offer => offer.IsLiveValidated)
            .ThenByDescending(offer => offer.Preferred)
            .ThenBy(offer => offer.IsLiveValidated ? offer.PriceCents : long.MaxValue)
            .ThenByDescending(offer => offer.ReliabilityScore)
            .FirstOrDefault();
    }

    private static string FormatCurrency(long cents)
    {
        return $"{(cents / 100m).ToString("N2", CultureInfo.CurrentCulture)} \u20AC";
    }

    private static long CalculateDefaultTargetPriceCents(SellerOffer? offer)
    {
        if (offer is null || offer.PriceCents <= 0)
        {
            return 100;
        }

        return Math.Max(100, (long)Math.Round(offer.PriceCents * 0.9m, MidpointRounding.ToZero));
    }

    private static string FormatPriceInputValue(long cents)
    {
        return (cents / 100m).ToString("0.00", CultureInfo.InvariantCulture);
    }

    private static string TrustLabel(SellerOffer offer)
    {
        return offer.ReliabilityScore > 0
            ? $"{offer.ReliabilityScore}/100"
            : "-";
    }

    private string DisplayPrice(SellerOffer offer)
    {
        return offer.IsLiveValidated ? offer.Price : T["Checkout.PriceToConfirm"];
    }

    private string PriceConfidenceLine(SellerOffer offer)
    {
        if (offer.IsLiveValidated && offer.ValidatedUtc is not null)
        {
            return T.Format("Checkout.LiveValidatedAt", FormatDateTime(offer.ValidatedUtc.Value));
        }

        return offer.IsLiveValidated ? T["Checkout.LivePriceVerified"] : T["Checkout.EstimatedPriceWarning"];
    }

    private static string FormatDateTime(DateTime value)
    {
        return value.ToLocalTime().ToString("dd/MM/yyyy HH:mm", CultureInfo.CurrentCulture);
    }

    private string ShippingDisplay(SellerOffer offer)
    {
        var delivery = offer.Delivery ?? string.Empty;
        if (delivery.Contains("grátis", StringComparison.OrdinalIgnoreCase)
            || delivery.Contains("gratis", StringComparison.OrdinalIgnoreCase)
            || delivery.Contains("free", StringComparison.OrdinalIgnoreCase))
        {
            return T["Checkout.FreeShipping"];
        }

        return string.IsNullOrWhiteSpace(offer.Delivery)
            ? T["Checkout.PriceToConfirm"]
            : offer.Delivery;
    }

    private static string OfferTrustLine(SellerOffer offer)
    {
        return string.IsNullOrWhiteSpace(offer.LocationLabel)
            ? TrustLabel(offer)
            : $"{TrustLabel(offer)} \u00B7 {offer.LocationLabel}";
    }

    private static string HumanizeProductSlug(string slug)
    {
        return string.Join(
            ' ',
            slug.Split('-', StringSplitOptions.RemoveEmptyEntries | StringSplitOptions.TrimEntries)
                .Select(word => word.Length == 0 ? word : char.ToUpperInvariant(word[0]) + word[1..]));
    }
}
