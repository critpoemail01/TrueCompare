@page "/results"
@inject IProductDiscoveryService DiscoveryService
@inject IProductSuggestionService SuggestionService
@inject IStoreOfferValidationService StoreOfferValidator
@inject AppText T

<PageTitle>@T["Results.PageTitle"]</PageTitle>

<section class="page-header compact-header results-header">
    <div class="results-header-copy">
        <h1>@T["Results.Title"]</h1>
        <p>@T.Format("Results.Subtitle", Products.Count)</p>
    </div>
</section>

@if (Products.Count == 0)
{
    <section class="empty-state results-empty-state">
        <h2>@T["Results.EmptyTitle"]</h2>
        <p>@T["Results.EmptyLead"]</p>
        <a class="primary-button" href="/">@T["Nav.NewChat"]</a>
    </section>
}
else
{
    <section class="ai-suggestion-panel results-ai-panel results-suggestion-panel" aria-live="polite">
        <div class="ai-suggestion-head">
            <div>
                <p class="eyebrow">@T["Results.AiSuggestion"]</p>
                <h2>@(AiSuggestions?.Intent ?? ActiveQuery)</h2>
            </div>
            <span class="ai-source-pill">@(IsLoadingSuggestions ? T["Results.Analyzing"] : AiSuggestions?.SourceLabel)</span>
        </div>

        @if (IsLoadingSuggestions)
        {
            <div class="ai-loading">
                <span></span>
                <strong>@T["Results.Preparing"]</strong>
            </div>
        }
        else if (AiSuggestions is not null)
        {
            <p class="ai-summary">@AiSuggestions.Summary</p>

            <div class="signal-row">
                @foreach (var signal in AiSuggestions.BuyingSignals)
                {
                    <span>@signal</span>
                }
            </div>
        }

        <section class="results-grid suggestion-products-grid">
            @foreach (var product in Products)
            {
                <article class="product-card @(product.Rank == 1 ? "featured" : null)" style="--accent:@product.Accent">
                    <div class="rank-line">
                        <span>#@product.Rank</span>
                        <strong>@product.Score</strong>
                    </div>

                    <h2>@product.Name</h2>
                    <div class="price">@product.Price</div>

                    <dl class="spec-list result-spec-list">
                        @foreach (var spec in CardSpecs(product))
                        {
                            <div>
                                <dt>@T["Results.Spec"]</dt>
                                <dd>@spec</dd>
                            </div>
                        }
                    </dl>

                    <p class="verified-line">@T["Results.Verified"]</p>
                    <span class="badge">@product.Badge</span>

                    <a class="card-action" href="@ProductUrl(product)">@T["Results.Details"]</a>
                </article>
            }
        </section>

        <p class="disclaimer">@T["Results.Disclaimer"]</p>

        @if (AiSuggestions?.Warnings.Count > 0)
        {
            <div class="ai-warning-row">
                @foreach (var warning in AiSuggestions.Warnings)
                {
                    <span>@warning</span>
                }
            </div>
        }
    </section>
}

@code {
    [SupplyParameterFromQuery]
    public string? Query { get; set; }

    private IReadOnlyList<ProductResult> Products { get; set; } = Array.Empty<ProductResult>();

    private IReadOnlyList<SellerOffer> Offers { get; set; } = Array.Empty<SellerOffer>();

    private LlmSuggestionResult? AiSuggestions { get; set; }

    private bool IsLoadingSuggestions { get; set; }

    private string ActiveQuery => string.IsNullOrWhiteSpace(Query)
        ? T["Results.DefaultQuery"]
        : Query;

    private static IReadOnlyList<string> CardSpecs(ProductResult product)
    {
        var specs = product.Specs;
        var result = new List<string>(4);

        if (specs.Count >= 2)
        {
            result.Add($"{specs[0]} \u00B7 {specs[1]}");
        }
        else if (specs.Count == 1)
        {
            result.Add(specs[0]);
        }

        if (specs.Count >= 3)
        {
            result.Add(specs[2]);
        }

        if (specs.Count >= 5)
        {
            result.Add($"{specs[3]} \u00B7 {specs[4]}");
        }
        else if (specs.Count >= 4)
        {
            result.Add(specs[3]);
        }

        if (specs.Count >= 6)
        {
            result.Add(specs[5]);
        }

        return result;
    }

    protected override async Task OnParametersSetAsync()
    {
        IsLoadingSuggestions = true;
        var discovery = await DiscoveryService.DiscoverAsync(ActiveQuery);
        var validatedProducts = await ValidateResultProductsAsync(discovery.Products);
        Products = validatedProducts
            .Select((item, index) => ApplyResultOfferPrice(item.Product, item.Offers) with { Rank = index + 1 })
            .ToList();
        Offers = validatedProducts
            .SelectMany(item => item.Offers)
            .ToList();
        AiSuggestions = await SuggestionService.GetSuggestionsAsync(ActiveQuery, Products, Offers);
        IsLoadingSuggestions = false;
    }

    private async Task<IReadOnlyList<ResultProductOffers>> ValidateResultProductsAsync(IReadOnlyList<ProductResult> products)
    {
        var validations = await Task.WhenAll(products.Select(async product =>
        {
            var candidateOffers = await DiscoveryService.GetSellerOffersAsync(product.Slug, ActiveQuery);
            var directOffers = candidateOffers
                .Where(ComparisonDataService.IsConfirmedStoreOffer)
                .ToList();
            var validatedOffers = await StoreOfferValidator.ValidateConfirmedOffersAsync(product, directOffers);
            return new ResultProductOffers(product, validatedOffers);
        }));

        return validations
            .Where(item => item.Offers.Count > 0)
            .ToList();
    }

    private static ProductResult ApplyResultOfferPrice(ProductResult product, IReadOnlyList<SellerOffer> offers)
    {
        var bestOffer = offers
            .OrderByDescending(offer => offer.Preferred)
            .ThenBy(offer => offer.PriceCents)
            .ThenByDescending(offer => offer.ReliabilityScore)
            .FirstOrDefault();

        return bestOffer is null ? product : product with { Price = bestOffer.Price };
    }

    private string ProductUrl(ProductResult product)
    {
        return string.IsNullOrWhiteSpace(Query)
            ? $"/product/{product.Slug}"
            : $"/product/{product.Slug}?query={Uri.EscapeDataString(Query)}";
    }

    private sealed record ResultProductOffers(ProductResult Product, IReadOnlyList<SellerOffer> Offers);

}
