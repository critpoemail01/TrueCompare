@page "/results"
@using System.Security.Claims
@using Microsoft.AspNetCore.RateLimiting
@attribute [Authorize]
@attribute [EnableRateLimiting("search")]
@inject SearchOrchestratorService SearchOrchestrator
@inject AppText T
@inject AuthenticationStateProvider AuthenticationStateProvider
@inject NavigationManager Navigation
@inject ILogger<Results> Logger

<PageTitle>@T["Results.PageTitle"]</PageTitle>

<section class="page-header compact-header results-header">
    <div class="results-header-copy">
        <h1>@T["Results.Title"]</h1>
        <p>@T.Format("Results.Subtitle", Products.Count)</p>
    </div>
</section>

@if (Products.Count == 0)
{
    <section class="empty-state results-empty-state">
        <h2>@T["Results.EmptyTitle"]</h2>
        <p>@T["Results.EmptyLead"]</p>
        @if (!string.IsNullOrWhiteSpace(SearchMessage))
        {
            <p class="quota-message">@SearchMessage</p>
        }
        <a class="primary-button" href="/">@T["Nav.NewChat"]</a>
    </section>
}
else
{
    <section class="ai-suggestion-panel results-ai-panel results-suggestion-panel" aria-live="polite">
        <div class="ai-suggestion-head">
            <div>
                <p class="eyebrow">@T["Results.AiSuggestion"]</p>
                <h2>@(AiSuggestions?.Intent ?? ActiveQuery)</h2>
            </div>
            <span class="ai-source-pill">@(IsLoadingSuggestions ? T["Results.Analyzing"] : AiSuggestions?.SourceLabel)</span>
        </div>

        @if (IsLoadingSuggestions)
        {
            <div class="ai-loading">
                <span></span>
                <strong>@T["Results.Preparing"]</strong>
            </div>
        }
        else if (AiSuggestions is not null)
        {
            <p class="ai-summary">@AiSuggestions.Summary</p>

            <div class="signal-row">
                @foreach (var signal in AiSuggestions.BuyingSignals)
                {
                    <span>@signal</span>
                }
            </div>

            @if (AiSuggestions.SuggestedQueries.Count > 0)
            {
                <div class="suggested-query-row" aria-label='@T.Pick("Pesquisas sugeridas", "Suggested searches")'>
                    @foreach (var suggestedQuery in AiSuggestions.SuggestedQueries.Take(4))
                    {
                        <a class="suggested-query-chip" href="@SuggestedQueryUrl(suggestedQuery)">@suggestedQuery</a>
                    }
                </div>
            }

            @if (AiSuggestions.ProductLeads.Count > 0)
            {
                <div class="product-lead-row">
                    @foreach (var lead in AiSuggestions.ProductLeads.Take(3))
                    {
                        <article class="product-lead-card">
                            <span>@lead.Source</span>
                            <strong>@lead.Name</strong>
                            <p>@lead.Reason</p>
                            <a href="@SuggestedQueryUrl(lead.SearchHint)">@T.Pick("Pesquisar esta alternativa", "Search this alternative")</a>
                        </article>
                    }
                </div>
            }
        }

        <section class="results-grid suggestion-products-grid">
            @foreach (var product in Products)
            {
                <article class="product-card @(product.Rank == 1 ? "featured" : null)" style="--accent:@product.Accent">
                    <div class="rank-line">
                        <span>#@product.Rank</span>
                        <strong>@product.Score</strong>
                    </div>

                    <h2>@product.Name</h2>
                    <div class="price">@product.Price</div>

                    <dl class="spec-list result-spec-list">
                        @foreach (var spec in CardSpecs(product))
                        {
                            <div>
                                <dt>@T["Results.Spec"]</dt>
                                <dd>@spec</dd>
                            </div>
                        }
                    </dl>

                    <p class="verified-line">@OfferValidationText(product)</p>
                    <p class="store-suggestion-line">@StoreSuggestionText(product)</p>
                    <span class="badge">@product.Badge</span>

                    <a class="card-action" href="@ProductUrl(product)">@T["Results.Details"]</a>
                </article>
            }
        </section>

        <p class="disclaimer">@T["Results.Disclaimer"]</p>

        @if (AiSuggestions?.Warnings.Count > 0)
        {
            <div class="ai-warning-row">
                @foreach (var warning in AiSuggestions.Warnings)
                {
                    <span>@warning</span>
                }
            </div>
        }
    </section>
}

@code {
    [SupplyParameterFromQuery]
    public string? Query { get; set; }

    [SupplyParameterFromQuery(Name = "requestId")]
    public string? RequestId { get; set; }

    private IReadOnlyList<ProductResult> Products { get; set; } = Array.Empty<ProductResult>();

    private IReadOnlyList<SellerOffer> Offers { get; set; } = Array.Empty<SellerOffer>();

    private IReadOnlyDictionary<string, SearchProductOfferSummary> ProductOfferSummaries { get; set; } =
        new Dictionary<string, SearchProductOfferSummary>(StringComparer.OrdinalIgnoreCase);

    private LlmSuggestionResult? AiSuggestions { get; set; }

    private bool IsLoadingSuggestions { get; set; }

    private string? SearchMessage { get; set; }

    private string? loadedRequestSignature;

    private string ActiveQuery => Query?.Trim() ?? string.Empty;

    private static IReadOnlyList<string> CardSpecs(ProductResult product)
    {
        var specs = product.Specs;
        var result = new List<string>(4);

        if (specs.Count >= 2)
        {
            result.Add($"{specs[0]} \u00B7 {specs[1]}");
        }
        else if (specs.Count == 1)
        {
            result.Add(specs[0]);
        }

        if (specs.Count >= 3)
        {
            result.Add(specs[2]);
        }

        if (specs.Count >= 5)
        {
            result.Add($"{specs[3]} \u00B7 {specs[4]}");
        }
        else if (specs.Count >= 4)
        {
            result.Add(specs[3]);
        }

        if (specs.Count >= 6)
        {
            result.Add(specs[5]);
        }

        return result;
    }

    protected override async Task OnParametersSetAsync()
    {
        var query = ActiveQuery.Trim();

        if (string.IsNullOrWhiteSpace(query))
        {
            loadedRequestSignature = null;
            Products = Array.Empty<ProductResult>();
            Offers = Array.Empty<SellerOffer>();
            ProductOfferSummaries = new Dictionary<string, SearchProductOfferSummary>(StringComparer.OrdinalIgnoreCase);
            AiSuggestions = null;
            SearchMessage = T.Pick(
                "Escreve uma pesquisa para veres resultados. Esta página não consome créditos sem uma pesquisa explícita.",
                "Enter a search query to see results. This page does not use credits without an explicit query.");
            IsLoadingSuggestions = false;
            return;
        }

        if (string.IsNullOrWhiteSpace(RequestId))
        {
            var redirectedUrl = $"/results?query={Uri.EscapeDataString(query)}&requestId={Guid.NewGuid():N}";
            Navigation.NavigateTo(redirectedUrl, replace: true);
            return;
        }

        var requestSignature = $"{query}|{RequestId}";
        if (string.Equals(loadedRequestSignature, requestSignature, StringComparison.Ordinal))
        {
            return;
        }

        loadedRequestSignature = requestSignature;
        await LoadResultsAsync(query);
    }

    private async Task LoadResultsAsync(string query)
    {
        IsLoadingSuggestions = true;
        SearchMessage = null;
        Products = Array.Empty<ProductResult>();
        Offers = Array.Empty<SellerOffer>();
        ProductOfferSummaries = new Dictionary<string, SearchProductOfferSummary>(StringComparer.OrdinalIgnoreCase);
        AiSuggestions = null;

        try
        {
            var authState = await AuthenticationStateProvider.GetAuthenticationStateAsync();
            var userId = authState.User.FindFirst(ClaimTypes.NameIdentifier)?.Value;
            var resultsUrl = BuildResultsUrl(query);

            if (string.IsNullOrWhiteSpace(userId))
            {
                Navigation.NavigateTo($"/login?returnUrl={Uri.EscapeDataString(resultsUrl)}", forceLoad: true);
                return;
            }

            var result = await SearchOrchestrator.ExecuteAsync(userId, query, RequestId, CancellationToken.None);
            if (!result.Allowed)
            {
                Navigation.NavigateTo($"/credits?returnUrl={Uri.EscapeDataString(resultsUrl)}&message={Uri.EscapeDataString(T["Home.NoCredits"])}", forceLoad: true);
                return;
            }

            Products = result.Products;
            Offers = result.Offers;
            ProductOfferSummaries = result.ProductOfferSummaries;
            AiSuggestions = result.AiSuggestions;
            SearchMessage = result.Message;
        }
        catch (Exception exception)
        {
            Logger.LogError(exception, "Failed to load results for query {Query}.", query);
            SearchMessage = T.Pick(
                "Esta pesquisa falhou antes de gerar resultados úteis e não foi debitada.",
                "This search failed before useful results were produced and was not charged.");
        }
        finally
        {
            IsLoadingSuggestions = false;
        }
    }

    private string BuildResultsUrl(string query)
    {
        var resultsUrl = $"/results?query={Uri.EscapeDataString(query)}";
        if (!string.IsNullOrWhiteSpace(RequestId))
        {
            resultsUrl += $"&requestId={Uri.EscapeDataString(RequestId)}";
        }

        return resultsUrl;
    }

    private string OfferValidationText(ProductResult product)
    {
        if (ProductOfferSummaries.TryGetValue(product.Slug, out var summary))
        {
            var bestLiveOffer = summary.Offers
                .Where(offer => offer.IsLiveValidated)
                .OrderByDescending(offer => offer.Preferred)
                .ThenBy(offer => offer.PriceCents)
                .ThenByDescending(offer => offer.ReliabilityScore)
                .FirstOrDefault();
            if (bestLiveOffer is not null)
            {
                var validatedAt = bestLiveOffer.ValidatedUtc is null
                    ? T["Results.LiveOfferValidatedNow"]
                    : T.Format("Results.LiveOfferValidatedAt", bestLiveOffer.ValidatedUtc.Value.ToLocalTime().ToString("dd/MM/yyyy HH:mm", System.Globalization.CultureInfo.CurrentCulture));
                return T.Format("Results.LiveOfferValidated", bestLiveOffer.Seller, validatedAt);
            }

            if (summary.CandidateOffers.Count > 0)
            {
                return T.Format("Results.KnownStoresPending", summary.CandidateOffers.Count);
            }
        }

        return T["Results.ProductFoundPricePending"];
    }


    private string StoreSuggestionText(ProductResult product)
    {
        if (!ProductOfferSummaries.TryGetValue(product.Slug, out var summary))
        {
            return T.Pick("Lojas sugeridas a confirmar no detalhe.", "Suggested stores to confirm in detail.");
        }

        var sellers = summary.CandidateOffers
            .OrderByDescending(offer => offer.IsLiveValidated)
            .ThenByDescending(offer => offer.Preferred)
            .ThenByDescending(offer => offer.IsLivePrice)
            .ThenByDescending(offer => offer.ReliabilityScore)
            .Select(offer => offer.Seller)
            .Distinct(StringComparer.OrdinalIgnoreCase)
            .Take(3)
            .ToList();

        return sellers.Count == 0
            ? T.Pick("Ainda sem lojas úteis para esta pesquisa.", "No useful stores for this search yet.")
            : T.Pick($"Lojas sugeridas: {string.Join(", ", sellers)}", $"Suggested stores: {string.Join(", ", sellers)}");
    }

    private static string SuggestedQueryUrl(string query)
    {
        return $"/results?query={Uri.EscapeDataString(query)}";
    }

    private string ProductUrl(ProductResult product)
    {
        var url = string.IsNullOrWhiteSpace(Query)
            ? $"/product/{product.Slug}"
            : $"/product/{product.Slug}?query={Uri.EscapeDataString(Query)}";

        if (!string.IsNullOrWhiteSpace(RequestId))
        {
            url += url.Contains('?') ? "&" : "?";
            url += $"requestId={Uri.EscapeDataString(RequestId)}";
        }

        return url;
    }
}
